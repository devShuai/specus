{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specus.devshuai.com/schemas/peer-control.schema.json",
  "title": "specus PEER_CONTROL",
  "description": "MessageType.PEER_CONTROL 的 JSON 信令。Java 使用同一个 PeerControlMessage DTO 承载多种 type。",
  "oneOf": [
    {
      "$ref": "#/$defs/PeerConfig"
    },
    {
      "$ref": "#/$defs/Roster"
    },
    {
      "$ref": "#/$defs/SessionGrant"
    },
    {
      "$ref": "#/$defs/Candidates"
    },
    {
      "$ref": "#/$defs/PathReport"
    },
    {
      "$ref": "#/$defs/TrafficReport"
    },
    {
      "$ref": "#/$defs/DeviceReport"
    },
    {
      "$ref": "#/$defs/Close"
    },
    {
      "$ref": "#/$defs/ServiceReport"
    },
    {
      "$ref": "#/$defs/ServiceCatalog"
    },
    {
      "$ref": "#/$defs/EgressConfig"
    },
    {
      "$ref": "#/$defs/EgressCatalog"
    },
    {
      "$ref": "#/$defs/EgressReport"
    }
  ],
  "$defs": {
    "EgressDestinationRule": {
      "type": "object",
      "required": [
        "cidr"
      ],
      "properties": {
        "cidr": {
          "type": "string",
          "description": "允许的目标 IPv4 网段。"
        },
        "protocols": {
          "type": "array",
          "items": {
            "enum": [
              "tcp",
              "udp"
            ]
          }
        },
        "portRanges": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          },
          "description": "闭区间 [起, 止]。"
        }
      }
    },
    "EgressConfig": {
      "description": "服务端 → 出口设备。开关或策略变更后立即下发。revision 在同一控制 session 内单调递增，不大于上次接受值的快照被忽略。不认识的键一律忽略。",
      "allOf": [
        {
          "$ref": "#/$defs/BaseMessage"
        },
        {
          "type": "object",
          "required": [
            "type",
            "revision",
            "enabled"
          ],
          "properties": {
            "type": {
              "const": "egress-config"
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            },
            "enabled": {
              "type": "boolean",
              "description": "转为 false 时出口立即停止接受新流并关闭全部已建流。"
            },
            "scope": {
              "type": "string",
              "description": "PUBLIC 或 LAN，客户端读取时去空白并转大写。缺失时消息仍被接受，但判定一律拒绝，不回落到 PUBLIC；关闭出口的推送不带 scope。"
            },
            "allowedConsumerClientIds": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/LongId"
              }
            },
            "destinationRules": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/EgressDestinationRule"
              },
              "description": "空 = 全部拒绝，不存在「未配置即放行」。"
            },
            "limits": {
              "type": "object",
              "description": "关闭出口的推送不带 limits；缺失时三个字段按 0 处理，由使用方兜底。",
              "properties": {
                "maxConcurrentFlows": {
                  "type": "integer",
                  "minimum": 0
                },
                "maxFlowsPerConsumer": {
                  "type": "integer",
                  "minimum": 0
                },
                "idleTimeoutSeconds": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      ]
    },
    "EgressCatalog": {
      "description": "服务端 → 消费设备，列出可用出口及其能力，不含出口的目标白名单。只能由服务端发出。当前三个客户端都不处理这条消息。",
      "allOf": [
        {
          "$ref": "#/$defs/BaseMessage"
        },
        {
          "type": "object",
          "required": [
            "type",
            "revision",
            "egresses"
          ],
          "properties": {
            "type": {
              "const": "egress-catalog"
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            },
            "egresses": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "clientId"
                ],
                "properties": {
                  "clientId": {
                    "$ref": "#/$defs/LongId"
                  },
                  "clientName": {
                    "type": "string"
                  },
                  "online": {
                    "type": "boolean"
                  },
                  "scope": {
                    "type": "string",
                    "description": "PUBLIC 或 LAN。客户端读取时去空白并转大写。"
                  },
                  "protocols": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "tcp",
                        "udp"
                      ]
                    }
                  },
                  "domainTargetCapable": {
                    "type": "boolean"
                  },
                  "ipv6TargetCapable": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "EgressReport": {
      "description": "出口设备 → 服务端，仅用于管理端展示；不含目标地址、域名或请求内容。服务端从已认证连接绑定上报者身份，客户端必须省略全部 sourceClient*、targetClient*、sessionId 与 token 字段。当前三个客户端都不发送这条消息。",
      "allOf": [
        {
          "$ref": "#/$defs/BaseMessage"
        },
        {
          "type": "object",
          "required": [
            "type",
            "revision"
          ],
          "properties": {
            "type": {
              "const": "egress-report"
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            },
            "activeFlows": {
              "type": "integer",
              "minimum": 0
            },
            "totalFlows": {
              "type": "integer",
              "minimum": 0
            },
            "rejectedFlows": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              },
              "description": "按错误码聚合的拒绝计数。"
            },
            "bytesIn": {
              "type": "integer",
              "minimum": 0
            },
            "bytesOut": {
              "type": "integer",
              "minimum": 0
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "sourceClientId"
                ]
              },
              {
                "required": [
                  "sourceClientName"
                ]
              },
              {
                "required": [
                  "sourceVirtualIp"
                ]
              },
              {
                "required": [
                  "sourcePublicKey"
                ]
              },
              {
                "required": [
                  "targetClientId"
                ]
              },
              {
                "required": [
                  "targetClientName"
                ]
              },
              {
                "required": [
                  "targetVirtualIp"
                ]
              },
              {
                "required": [
                  "sessionId"
                ]
              },
              {
                "required": [
                  "token"
                ]
              }
            ]
          }
        }
      ]
    },
    "LongId": {
      "type": "integer",
      "minimum": 1
    },
    "Endpoint": {
      "type": "string",
      "minLength": 1,
      "description": "host:port、ip:port 或 relay:{allocationId}。"
    },
    "EpochMillis": {
      "type": "integer",
      "minimum": 0
    },
    "BaseMessage": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "createdAtMillis": {
          "$ref": "#/$defs/EpochMillis"
        }
      }
    },
    "ClientIdentityFields": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "sourceClientId": {
          "$ref": "#/$defs/LongId"
        },
        "sourceClientName": {
          "type": "string"
        },
        "sourceVirtualIp": {
          "type": "string",
          "format": "ipv4"
        },
        "sourcePublicKey": {
          "type": "string",
          "contentEncoding": "base64"
        },
        "targetClientId": {
          "$ref": "#/$defs/LongId"
        },
        "targetClientName": {
          "type": "string"
        },
        "targetVirtualIp": {
          "type": "string",
          "format": "ipv4"
        },
        "targetPublicKey": {
          "type": "string",
          "contentEncoding": "base64"
        }
      }
    },
    "PeerCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "transport",
        "address",
        "port",
        "priority",
        "addressFamily"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "host",
            "srflx",
            "relay"
          ]
        },
        "transport": {
          "type": "string",
          "enum": [
            "udp"
          ]
        },
        "address": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "priority": {
          "type": "integer",
          "minimum": 0
        },
        "foundation": {
          "type": "string"
        },
        "relayId": {
          "type": "string"
        },
        "addressFamily": {
          "type": "string",
          "enum": [
            "IPv4",
            "IPv6"
          ]
        }
      }
    },
    "PeerRosterItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clientId",
        "clientName",
        "virtualIp",
        "publicKey",
        "online"
      ],
      "properties": {
        "clientId": {
          "$ref": "#/$defs/LongId"
        },
        "clientName": {
          "type": "string",
          "minLength": 1
        },
        "virtualIp": {
          "type": "string",
          "format": "ipv4"
        },
        "publicKey": {
          "type": "string",
          "contentEncoding": "base64"
        },
        "online": {
          "type": "boolean"
        },
        "messageSendCapable": {
          "type": "boolean",
          "default": false
        },
        "messageReceiveCapable": {
          "type": "boolean",
          "default": false
        },
        "messageAttachmentsCapable": {
          "type": "boolean",
          "default": false
        },
        "messageMediaPreviewCapable": {
          "type": "boolean",
          "default": false
        },
        "messageMaxAttachmentBytes": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "peerServiceDiscoveryVersion": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "peerServiceApplications": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PeerServiceApplication"
          },
          "uniqueItems": true,
          "default": []
        }
      }
    },
    "PeerServiceTransport": {
      "type": "string",
      "enum": ["tcp", "udp"]
    },
    "PeerServiceApplication": {
      "type": "string",
      "enum": ["http", "https", "ssh", "tcp", "udp"]
    },
    "PeerAdvertisedService": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serviceId",
        "name",
        "transport",
        "application",
        "publishedPort"
      ],
      "properties": {
        "serviceId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "maxLength": 200
        },
        "transport": {
          "$ref": "#/$defs/PeerServiceTransport"
        },
        "application": {
          "$ref": "#/$defs/PeerServiceApplication"
        },
        "publishedPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "path": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^$|^/[A-Za-z0-9._~/-]*$"
        }
      }
    },
    "PeerServiceSharingStatus": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deploymentEnabled": {
          "type": "boolean",
          "default": false
        },
        "configuredEnabled": {
          "type": "boolean",
          "default": false
        },
        "effectiveEnabled": {
          "type": "boolean",
          "default": false
        },
        "mdnsImportEnabled": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "PeerMeshConfig": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "clientId": {
          "type": "integer",
          "minimum": 0
        },
        "clientName": {
          "type": [
            "string",
            "null"
          ]
        },
        "virtualIp": {
          "type": [
            "string",
            "null"
          ],
          "format": "ipv4"
        },
        "cidr": {
          "type": [
            "string",
            "null"
          ]
        },
        "stunHost": {
          "type": [
            "string",
            "null"
          ]
        },
        "stunPort": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "turnHost": {
          "type": [
            "string",
            "null"
          ]
        },
        "turnPort": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "publicStunServers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "iceUsername": {
          "type": [
            "string",
            "null"
          ]
        },
        "iceCredential": {
          "type": [
            "string",
            "null"
          ]
        },
        "iceRealm": {
          "type": [
            "string",
            "null"
          ]
        },
        "iceNonce": {
          "type": [
            "string",
            "null"
          ]
        },
        "serverPublicKey": {
          "type": [
            "string",
            "null"
          ]
        },
        "clientPublicKey": {
          "type": [
            "string",
            "null"
          ]
        },
        "sessionTtlSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "peerServiceDiscoveryVersion": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "serviceSharing": {
          "$ref": "#/$defs/PeerServiceSharingStatus"
        },
        "localServices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LocalPeerService"
          },
          "default": []
        }
      }
    },
    "LocalPeerService": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serviceId",
        "name",
        "transport",
        "application",
        "targetHost",
        "targetPort",
        "publishedPort",
        "enabled",
        "allowedPeerVirtualIps"
      ],
      "properties": {
        "serviceId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "maxLength": 200
        },
        "transport": {
          "$ref": "#/$defs/PeerServiceTransport"
        },
        "application": {
          "$ref": "#/$defs/PeerServiceApplication"
        },
        "targetHost": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "targetPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "publishedPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "path": {
          "type": "string",
          "maxLength": 128
        },
        "enabled": {
          "type": "boolean"
        },
        "visibility": {
          "type": "string",
          "enum": ["OWNER", "ACL"]
        },
        "allowedPeerVirtualIps": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 45
          },
          "default": []
        }
      }
    },
    "PeerConfig": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseMessage"
        },
        {
          "type": "object",
          "required": [
            "type",
            "peerMesh"
          ],
          "properties": {
            "type": {
              "const": "peer-config"
            },
            "sourceClientId": {
              "$ref": "#/$defs/LongId"
            },
            "sourceClientName": {
              "type": "string"
            },
            "peerMesh": {
              "$ref": "#/$defs/PeerMeshConfig"
            }
          }
        }
      ]
    },
    "Roster": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseMessage"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "clientId",
            "clientName",
            "peers"
          ],
          "properties": {
            "type": {
              "const": "roster"
            },
            "clientId": {
              "$ref": "#/$defs/LongId"
            },
            "clientName": {
              "type": "string",
              "minLength": 1
            },
            "peers": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/PeerRosterItem"
              }
            }
          }
        }
      ]
    },
    "SessionGrant": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseMessage"
        },
        {
          "$ref": "#/$defs/ClientIdentityFields"
        },
        {
          "type": "object",
          "required": [
            "type",
            "sessionId",
            "sourceClientId",
            "targetClientId",
            "token",
            "expiresAt"
          ],
          "properties": {
            "type": {
              "const": "session-grant"
            },
            "sessionId": {
              "$ref": "#/$defs/LongId"
            },
            "token": {
              "type": "string",
              "minLength": 1
            },
            "expiresAt": {
              "type": "string",
              "format": "date-time"
            },
            "pathType": {
              "type": "string",
              "enum": [
                "DIRECT",
                "RELAY",
                "UNKNOWN"
              ]
            },
            "status": {
              "type": "string"
            }
          }
        }
      ]
    },
    "Candidates": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseMessage"
        },
        {
          "$ref": "#/$defs/ClientIdentityFields"
        },
        {
          "type": "object",
          "required": [
            "type",
            "targetClientId",
            "candidates"
          ],
          "properties": {
            "type": {
              "const": "candidates"
            },
            "sessionId": {
              "$ref": "#/$defs/LongId"
            },
            "token": {
              "type": "string"
            },
            "expiresAt": {
              "type": "string",
              "format": "date-time"
            },
            "candidates": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/PeerCandidate"
              }
            }
          }
        }
      ]
    },
    "PathReport": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseMessage"
        },
        {
          "$ref": "#/$defs/ClientIdentityFields"
        },
        {
          "type": "object",
          "required": [
            "type",
            "sessionId",
            "pathType",
            "status",
            "remoteEndpoint"
          ],
          "properties": {
            "type": {
              "const": "path-report"
            },
            "sessionId": {
              "$ref": "#/$defs/LongId"
            },
            "pathType": {
              "type": "string",
              "enum": [
                "DIRECT",
                "RELAY"
              ]
            },
            "status": {
              "type": "string"
            },
            "rttMillis": {
              "type": "integer",
              "minimum": 0
            },
            "localEndpoint": {
              "$ref": "#/$defs/Endpoint"
            },
            "remoteEndpoint": {
              "$ref": "#/$defs/Endpoint"
            }
          }
        }
      ]
    },
    "TrafficReport": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseMessage"
        },
        {
          "$ref": "#/$defs/ClientIdentityFields"
        },
        {
          "type": "object",
          "required": [
            "type",
            "sessionId"
          ],
          "properties": {
            "type": {
              "const": "traffic-report"
            },
            "sessionId": {
              "$ref": "#/$defs/LongId"
            },
            "directBytes": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "relayBytes": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        }
      ]
    },
    "DeviceReport": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseMessage"
        },
        {
          "$ref": "#/$defs/ClientIdentityFields"
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "device-report"
            },
            "virtualDeviceMode": {
              "type": "string"
            },
            "virtualDeviceName": {
              "type": "string"
            },
            "virtualDeviceStatus": {
              "type": "string"
            },
            "virtualDeviceError": {
              "type": "string"
            },
            "natType": {
              "type": "string"
            },
            "natMappingBehavior": {
              "type": "string"
            },
            "natFilteringBehavior": {
              "type": "string"
            },
            "natBehaviorDiscovery": {
              "type": "string"
            },
            "lastEndpoint": {
              "type": "string"
            }
          }
        }
      ]
    },
    "Close": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseMessage"
        },
        {
          "$ref": "#/$defs/ClientIdentityFields"
        },
        {
          "type": "object",
          "required": [
            "type",
            "sessionId"
          ],
          "properties": {
            "type": {
              "const": "close"
            },
            "sessionId": {
              "$ref": "#/$defs/LongId"
            },
            "status": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          }
        }
      ]
    },
    "ServiceReport": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseMessage"
        },
        {
          "type": "object",
          "required": [
            "type",
            "enabled",
            "revision",
            "services"
          ],
          "properties": {
            "type": {
              "const": "service-report"
            },
            "enabled": {
              "type": "boolean"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "publisherSessionId": {
              "description": "服务端根据认证控制连接绑定；客户端 service-report 必须省略。",
              "$ref": "#/$defs/LongId"
            },
            "instanceId": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^(?:[A-Za-z0-9._-]{1,64})?$"
            },
            "generatedAt": {
              "type": "string",
              "format": "date-time"
            },
            "expiresAt": {
              "type": "string",
              "format": "date-time"
            },
            "services": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "$ref": "#/$defs/PeerAdvertisedService"
              }
            },
            "stats": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "$ref": "#/$defs/PeerServiceStats"
              }
            },
            "mdnsCandidates": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "$ref": "#/$defs/PeerMdnsCandidate"
              }
            }
          },
          "not": {
            "anyOf": [
              { "required": ["sourceClientId"] },
              { "required": ["sourceClientName"] },
              { "required": ["sourceVirtualIp"] },
              { "required": ["sourcePublicKey"] },
              { "required": ["sourceKeyEpoch"] },
              { "required": ["targetClientId"] },
              { "required": ["targetClientName"] },
              { "required": ["targetVirtualIp"] },
              { "required": ["targetPublicKey"] },
              { "required": ["sessionId"] },
              { "required": ["token"] },
              { "required": ["publisherClientId"] },
              { "required": ["publisherClientName"] },
              { "required": ["publisherSessionId"] }
            ]
          }
        }
      ]
    },
    "PeerMdnsCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "transport", "application", "targetHost", "targetPort"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "transport": { "$ref": "#/$defs/PeerServiceTransport" },
        "application": { "$ref": "#/$defs/PeerServiceApplication" },
        "targetHost": { "type": "string", "minLength": 1, "maxLength": 64 },
        "targetPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "PeerServiceStats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serviceId"
      ],
      "properties": {
        "serviceId": {
          "type": "string"
        },
        "bytesIn": {
          "type": "integer",
          "minimum": 0
        },
        "bytesOut": {
          "type": "integer",
          "minimum": 0
        },
        "activeConnections": {
          "type": "integer",
          "minimum": 0
        },
        "totalConnections": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ServiceCatalog": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseMessage"
        },
        {
          "type": "object",
          "required": [
            "type",
            "publisherClientId",
            "publisherSessionId",
            "revision",
            "services"
          ],
          "properties": {
            "type": {
              "const": "service-catalog"
            },
            "publisherClientId": {
              "$ref": "#/$defs/LongId"
            },
            "publisherClientName": {
              "type": "string",
              "minLength": 1
            },
            "publisherSessionId": {
              "$ref": "#/$defs/LongId"
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            },
            "expiresAt": {
              "type": "string",
              "format": "date-time"
            },
            "services": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "$ref": "#/$defs/PeerAdvertisedService"
              }
            }
          }
        }
      ]
    }
  }
}
