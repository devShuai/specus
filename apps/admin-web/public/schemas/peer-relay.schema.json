{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specus.devshuai.com/schemas/peer-relay.schema.json",
  "title": "specus Peer direct UDP connectivity check",
  "description": "Peer Mesh 客户端之间的 direct UDP check/check-response JSON。服务端 STUN/TURN 控制面使用标准二进制协议，不由本 Schema 描述。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "magic",
    "type",
    "sessionId",
    "fromClientId",
    "toClientId",
    "nonce",
    "token",
    "sentAtMillis"
  ],
  "properties": {
    "magic": {
      "const": "specus-peer-mesh"
    },
    "type": {
      "type": "string",
      "enum": [
        "check",
        "check-response"
      ]
    },
    "sessionId": {
      "$ref": "#/$defs/LongId"
    },
    "fromClientId": {
      "$ref": "#/$defs/LongId"
    },
    "toClientId": {
      "$ref": "#/$defs/LongId"
    },
    "nonce": {
      "type": "string",
      "minLength": 1
    },
    "token": {
      "type": "string",
      "minLength": 1
    },
    "sentAtMillis": {
      "type": "integer",
      "minimum": 0
    }
  },
  "$defs": {
    "LongId": {
      "type": "integer",
      "minimum": 1
    }
  }
}
