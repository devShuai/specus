{
  "name": "admin-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "specus 管理后台前端 (React + HeroUI)",
  "scripts": {
    "dev": "vite",
    "sync:drawio-stencils": "node scripts/sync-drawio-stencils.mjs",
    "sync:schemas": "node scripts/sync-schemas.mjs",
    "build": "npm run sync:schemas && npm run verify:csp && tsc --noEmit && vite build && npm run verify:csp:dist",
    "build:openresty": "npm run build && node scripts/precompress.mjs",
    "precompress": "node scripts/precompress.mjs",
    "verify:csp": "node scripts/verify-csp.mjs",
    "verify:csp:dist": "node scripts/verify-csp.mjs --index dist/index.html",
    "verify:peer-service-wire": "node scripts/verify-peer-service-wire.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy": "npm run deploy:all",
    "deploy:all": "npm run build && node scripts/deploy.mjs --target all",
    "deploy:java": "npm run build && node scripts/deploy.mjs --target java",
    "deploy:go": "npm run build && node scripts/deploy.mjs --target go",
    "deploy:csharp": "npm run build && node scripts/deploy.mjs --target csharp"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@heroui/react": "^3.2.4",
    "@maxgraph/core": "^0.24.0",
    "@react-aria/i18n": "^3.13.1",
    "@react-aria/ssr": "^3.10.1",
    "@react-aria/utils": "^3.34.1",
    "dashjs": "^5.2.0",
    "fflate": "^0.8.3",
    "framer-motion": "^13.1.0",
    "hls.js": "^1.7.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.27.0",
    "mp4box": "^2.4.1",
    "pako": "^3.0.1",
    "react": "^19.2.8",
    "react-aria": "^3.51.0",
    "react-aria-components": "^1.20.0",
    "react-dom": "^19.2.8",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@xmldom/xmldom": "^0.9.10",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "dompurify": "^3.4.14"
  }
}
