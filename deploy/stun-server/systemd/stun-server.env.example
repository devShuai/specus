# Standalone RFC 5780 STUN server configuration.
#
# Full behavior discovery needs four UDP endpoints:
#   A1:P1, A1:P2, A2:P1, A2:P2
# The host must own both bind addresses. In a cloud VPC, each private bind
# address can be mapped one-to-one to the corresponding public address.

STUN_PRIMARY_BIND_ADDRESS=10.0.0.10
STUN_PRIMARY_PUBLIC_ADDRESS=203.0.113.10
STUN_ALTERNATE_BIND_ADDRESS=10.0.0.11
STUN_ALTERNATE_PUBLIC_ADDRESS=203.0.113.11
STUN_PRIMARY_PORT=3478
STUN_ALTERNATE_PORT=3479

# Java-only two-node mode. Keep false for the single-host topology above.
# When enabled, both nodes advertise the same A1/A2 public pair, but each node
# binds only the two ports belonging to its local address slot. The private
# control socket must never be exposed to the public Internet.
STUN_DISTRIBUTED_ENABLED=false
#STUN_DISTRIBUTED_LOCAL_ADDRESS_SLOT=primary
#STUN_DISTRIBUTED_STUN_BIND_ADDRESS=0.0.0.0
#STUN_DISTRIBUTED_CONTROL_BIND_ADDRESS=10.0.0.10
#STUN_DISTRIBUTED_CONTROL_PORT=3480
#STUN_DISTRIBUTED_PEER_CONTROL_ADDRESS=10.0.1.10
#STUN_DISTRIBUTED_PEER_CONTROL_PORT=3480
#STUN_DISTRIBUTED_CURRENT_KEY_ID=1
#STUN_DISTRIBUTED_CURRENT_SECRET=REPLACE_WITH_BASE64_SECRET_OF_AT_LEAST_32_BYTES
# During rotation, keep the former key here until every node sends with the new current key.
#STUN_DISTRIBUTED_PREVIOUS_KEY_ID=0
#STUN_DISTRIBUTED_PREVIOUS_SECRET=REPLACE_WITH_FORMER_BASE64_SECRET
#STUN_DISTRIBUTED_MAX_CLOCK_SKEW_SECONDS=30
#STUN_DISTRIBUTED_REPLAY_WINDOW_SIZE=4096
#STUN_DISTRIBUTED_MAX_FORWARD_PACKET_BYTES=4096
#STUN_DISTRIBUTED_FORWARD_RATE_PER_SECOND=10000
#STUN_DISTRIBUTED_FORWARD_BURST=20000

STUN_SOFTWARE=shuai-tunnel-rfc5780-stun
STUN_LEGACY_SINGLE_IP_OTHER_ADDRESS=false

# Application-layer UDP protection. The per-source key is the source IP,
# so rotating source ports does not bypass the limiter.
STUN_RATE_LIMIT_PER_SECOND=100
STUN_RATE_LIMIT_BURST=200
STUN_GLOBAL_RATE_LIMIT_PER_SECOND=10000
STUN_GLOBAL_RATE_LIMIT_BURST=20000
STUN_MAX_TRACKED_SOURCES=65536
STUN_SOURCE_IDLE_SECONDS=300
STUN_MAX_PACKET_BYTES=65507

# PADDING responses are capped even if a larger request is received. Requests
# containing both PADDING and RESPONSE-PORT are rejected with STUN 400.
STUN_MAX_PADDING_RESPONSE_BYTES=1472

# Prometheus endpoint. Keep it on loopback and expose it through a local
# Prometheus agent or an authenticated reverse proxy.
STUN_METRICS_BIND_ADDRESS=127.0.0.1
STUN_METRICS_PORT=9108

JAVA_OPTS="-Xms32m -Xmx128m -XX:+UseG1GC -Dfile.encoding=UTF-8"
