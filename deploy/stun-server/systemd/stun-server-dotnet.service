[Unit]
Description=specus Standalone RFC 5780 STUN Server (.NET)
Documentation=https://github.com/devShuai/specus
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stun
Group=stun
WorkingDirectory=/var/lib/specus-stun-server
EnvironmentFile=/etc/specus-stun-server/stun-server.env

# A self-contained single-file publish can replace both commands with the
# published Specus.StunServer executable.
ExecStartPre=/usr/bin/dotnet /opt/specus-stun-server/dotnet/Specus.StunServer.dll --check-config
ExecStart=/usr/bin/dotnet /opt/specus-stun-server/dotnet/Specus.StunServer.dll

KillSignal=SIGTERM
TimeoutStopSec=10
Restart=on-failure
RestartSec=3s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=specus-stun-server-dotnet

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6
ReadWritePaths=/var/lib/specus-stun-server
UMask=0027
LimitNOFILE=4096
TasksMax=96
MemoryMax=384M

[Install]
WantedBy=multi-user.target
