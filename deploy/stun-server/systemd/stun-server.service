[Unit]
Description=specus Standalone RFC 5780 STUN Server
Documentation=https://github.com/devShuai/specus
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stun
Group=stun
WorkingDirectory=/var/lib/specus-stun-server

Environment=JAVA_OPTS=
EnvironmentFile=/etc/specus-stun-server/stun-server.env

ExecStartPre=/usr/bin/java $JAVA_OPTS -jar /opt/specus-stun-server/stun-server.jar --check-config
ExecStart=/usr/bin/java $JAVA_OPTS -jar /opt/specus-stun-server/stun-server.jar

KillSignal=SIGTERM
TimeoutStopSec=10
SuccessExitStatus=143
Restart=on-failure
RestartSec=3s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=specus-stun-server

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6
ReadWritePaths=/var/lib/specus-stun-server
UMask=0027
LimitNOFILE=4096
TasksMax=64
MemoryMax=256M

[Install]
WantedBy=multi-user.target
