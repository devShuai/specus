# C# Server 环境变量模板
# 复制为 /etc/tunnel-server-csharp/tunnel-server.env 并编辑
# 通过 TunnelEnvironmentVariables.cs 转换为 Tunnel:* 配置路径
# 模板默认禁用口令登录、Peer Mesh 和对象存储；不要在版本库或 world-readable 文件中写入真实密钥。

# Kestrel 监听地址
ASPNETCORE_URLS=http://0.0.0.0:8088
ASPNETCORE_ENVIRONMENT=Production

# 控制通道 TCP 端口
TUNNEL_NETTY_PORT=7010
# 完整控制帧上限（含 11 字节协议头）；33554432 对应最大消息体 33554421 字节。
TUNNEL_NETTY_MAX_FRAME_SIZE=33554432

# 数据库
# 可选: sqlite / postgres / mysql
TUNNEL_DB_PROVIDER=sqlite
# TUNNEL_CONNECTIONSTRINGS_TUNNEL 会被转换为 ConnectionStrings:Tunnel
TUNNEL_CONNECTIONSTRINGS_TUNNEL="Data Source=/var/lib/tunnel-server-csharp/tunnel.db"

# 对于 postgres:
# TUNNEL_DB_PROVIDER=postgres
# TUNNEL_CONNECTIONSTRINGS_TUNNEL=Host=127.0.0.1;Port=5432;Database=shuai_tunnel;Username=postgres;Password=xxx

# 对于 mysql:
# TUNNEL_DB_PROVIDER=mysql
# TUNNEL_CONNECTIONSTRINGS_TUNNEL=server=127.0.0.1;port=3306;user=root;password=xxx;database=shuai_tunnel

# TLS
TUNNEL_TLS_MODE=disabled
# TUNNEL_TLS_KEYSTORE=/etc/tunnel-server-csharp/tls/server.p12
# TUNNEL_TLS_KEYSTORE_PASSWORD=changeit
# TUNNEL_TLS_KEY_PASSWORD=changeit

# 管理员登录
# 默认保持关闭。仅在生成独立强口令与稳定 JWT 密钥后改为 true。
TUNNEL_AUTH_PASSWORD_LOGIN_ENABLED=false
TUNNEL_AUTH_REGISTRATION_ENABLED=false
TUNNEL_AUTH_USERNAME=admin
TUNNEL_AUTH_PASSWORD=
TUNNEL_AUTH_TENANT_ID=default
TUNNEL_AUTH_JWT_SECRET=
TUNNEL_AUTH_TOKEN_TTL_SECONDS=28800

# Cloudflare Turnstile。启用后，本地密码登录必须携带有效 token。
TUNNEL_AUTH_TURNSTILE_ENABLED=false
TUNNEL_AUTH_TURNSTILE_SITE_KEY=
TUNNEL_AUTH_TURNSTILE_SECRET_KEY=
TUNNEL_AUTH_TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
# 逗号分隔，服务端精确匹配 Siteverify 返回的 hostname。
TUNNEL_AUTH_TURNSTILE_ALLOWED_HOSTNAMES=tunnel.example.com

# 邮箱验证注册。仅当注册、密码登录、Turnstile、邮箱和 SMTP 都可用时才开放。
TUNNEL_AUTH_EMAIL_VERIFICATION_ENABLED=false
TUNNEL_AUTH_EMAIL_FROM_ADDRESS=
TUNNEL_AUTH_EMAIL_FROM_NAME=shuai-tunnel
TUNNEL_AUTH_EMAIL_SUBJECT=shuai-tunnel 注册验证码
TUNNEL_AUTH_EMAIL_CODE_TTL_SECONDS=600
TUNNEL_AUTH_EMAIL_MAX_ATTEMPTS=5
TUNNEL_AUTH_EMAIL_RESEND_COOLDOWN_SECONDS=60
TUNNEL_AUTH_EMAIL_CLEANUP_INTERVAL_MS=3600000
TUNNEL_AUTH_SMTP_HOST=
TUNNEL_AUTH_SMTP_PORT=587
TUNNEL_AUTH_SMTP_USERNAME=
TUNNEL_AUTH_SMTP_PASSWORD=
TUNNEL_AUTH_SMTP_AUTH=true
# 587 通常使用 STARTTLS；465 使用隐式 TLS 时设置 SMTP_SSL=true，并关闭以下两项。
TUNNEL_AUTH_SMTP_STARTTLS=true
TUNNEL_AUTH_SMTP_STARTTLS_REQUIRED=true
TUNNEL_AUTH_SMTP_SSL=false

# 客户端认证限制
TUNNEL_CLIENT_AUTH_DEFAULT_MAX_ONLINE_INSTANCES=2
TUNNEL_CLIENT_AUTH_PER_MACHINE_USER_MAX_INSTANCES=1
TUNNEL_CLIENT_AUTH_TOKEN_TTL_SECONDS=28800

# Peer Mesh 组网
TUNNEL_PEER_MESH_ENABLED=false
TUNNEL_PEER_MESH_CIDR=100.96.0.0/11
TUNNEL_PEER_MESH_PUBLIC_ADDRESS=
TUNNEL_PEER_MESH_STUN_TURN_PORT=3478
TUNNEL_PEER_MESH_NAT_PROBE_ALTERNATE_PORT=3479
TUNNEL_PEER_MESH_PUBLIC_STUN_SERVERS=
TUNNEL_PEER_MESH_SESSION_TTL_SECONDS=3600
TUNNEL_PEER_MESH_ALLOCATION_TTL_SECONDS=300
TUNNEL_PEER_MESH_SESSION_CLEANUP_INTERVAL_MS=60000
TUNNEL_PEER_MESH_RELAY_MIN_PORT=49152
TUNNEL_PEER_MESH_RELAY_MAX_PORT=65535
TUNNEL_PEER_MESH_RELAY_WORKER_THREADS=0
TUNNEL_PEER_MESH_RELAY_WORKER_QUEUE_CAPACITY=10000
TUNNEL_PEER_MESH_RELAY_TRAFFIC_FLUSH_INTERVAL_MS=5000
TUNNEL_PEER_MESH_TURN_AUTH_REQUIRED=true
TUNNEL_PEER_MESH_TURN_REALM=shuai-tunnel
TUNNEL_PEER_MESH_TURN_SHARED_SECRET=
TUNNEL_PEER_MESH_TURN_CREDENTIAL_TTL_SECONDS=3600

# ---- 通用中继配额（公开互传的浏览器 WebRTC 使用 TURN 时生效）----
# 浏览器经 TURN 转发 DTLS/SRTP，无法通过 Peer Mesh 专用校验，因此这类 allocation 按标准
# TURN 语义放行，目的地址被限制为公网单播（拒绝回环/内网/CGNAT/组播/ULA）。
# 以下配额避免它被当作开放中继刷带宽；MAX_ALLOCATIONS 设为 0 可完全关闭通用中继。
TUNNEL_PEER_MESH_GENERAL_RELAY_MAX_ALLOCATIONS=256
TUNNEL_PEER_MESH_GENERAL_RELAY_MAX_ALLOCATIONS_PER_ADDRESS=4
TUNNEL_PEER_MESH_GENERAL_RELAY_MAX_BYTES=536870912

# 公共文件互传 / 私有 OSS（可选）
# TUNNEL_OBJECT_STORAGE_PROVIDER=aliyun-oss
# TUNNEL_OBJECT_STORAGE_ENDPOINT=oss-cn-shanghai.aliyuncs.com
# TUNNEL_OBJECT_STORAGE_REGION=cn-shanghai
# TUNNEL_OBJECT_STORAGE_BUCKET=private-bucket
# TUNNEL_OBJECT_STORAGE_ACCESS_KEY_ID=
# TUNNEL_OBJECT_STORAGE_ACCESS_KEY_SECRET=
# TUNNEL_OBJECT_STORAGE_PREFIX=shuai-tunnel/attachments
# TUNNEL_OBJECT_STORAGE_UPLOAD_CALLBACK_URL=https://tunnel.devshuai.com/api/public/transfer/oss-callback
# TUNNEL_OBJECT_STORAGE_UPLOAD_URL_TTL_SECONDS=900
# TUNNEL_OBJECT_STORAGE_DOWNLOAD_URL_TTL_SECONDS=600
# TUNNEL_OBJECT_STORAGE_DOWNLOAD_OBJECT_URL_TTL_SECONDS=30
# TUNNEL_OBJECT_STORAGE_RETENTION_HOURS=72
# TUNNEL_OBJECT_STORAGE_MAX_ATTACHMENT_BYTES=536870912
# TUNNEL_OBJECT_STORAGE_PER_USER_STORAGE_QUOTA_BYTES=1073741824
# TUNNEL_OBJECT_STORAGE_PER_USER_MONTHLY_DOWNLOAD_QUOTA_BYTES=1073741824
# TUNNEL_OBJECT_STORAGE_EXPIRATION_SCAN_INTERVAL_MS=3600000
# TUNNEL_PUBLIC_TRANSFER_PRESIGN_RATE_LIMIT_PER_IP=30
# TUNNEL_PUBLIC_TRANSFER_PRESIGN_RATE_LIMIT_WINDOW_SECONDS=300
# TUNNEL_PUBLIC_TRANSFER_MAX_PENDING_UPLOADS_PER_ROOM=50
# TUNNEL_PUBLIC_TRANSFER_MAX_DISCOVERY_PEERS_PER_ROOM=32
# TUNNEL_PUBLIC_TRANSFER_DISCOVERY_MESSAGE_RATE_LIMIT_PER_CONNECTION=120
# TUNNEL_PUBLIC_TRANSFER_DISCOVERY_MESSAGE_RATE_LIMIT_WINDOW_SECONDS=60

# 流量捕获
TUNNEL_TRAFFIC_CAPTURE_DETAIL_ENABLED=false
TUNNEL_TRAFFIC_CAPTURE_DECODE_MAX_BYTES=1048576

# 客户端下载链接配置
TUNNEL_JAVA_CLIENT_PACKAGE_URL=
TUNNEL_JAVA_CLIENT_INSTALL_SCRIPT=
TUNNEL_GO_CLIENT_PACKAGE_URL=
TUNNEL_GO_CLIENT_INSTALL_SCRIPT=
TUNNEL_CSHARP_CLIENT_PACKAGE_URL=
TUNNEL_CSHARP_CLIENT_INSTALL_SCRIPT=
