[Unit]
Description=shuai-tunnel C# server
Documentation=https://github.com/devShuai/shuai-tunnel
After=network.target

[Service]
Type=simple
User=tunnel
Group=tunnel
WorkingDirectory=/var/lib/tunnel-server-csharp
EnvironmentFile=-/etc/tunnel-server-csharp/tunnel-server.env
ExecStart=/usr/bin/dotnet /opt/tunnel-server-csharp/ShuaiTunnel.Server.dll
KillSignal=SIGTERM
TimeoutStopSec=30
SuccessExitStatus=143
Restart=on-failure
RestartSec=5s

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
UMask=0027
ReadWritePaths=/var/lib/tunnel-server-csharp /var/log/tunnel-server-csharp
LimitNOFILE=65536

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tunnel-server-csharp

[Install]
WantedBy=multi-user.target