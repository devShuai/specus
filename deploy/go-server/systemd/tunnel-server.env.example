# Go Server 环境变量模板
# 复制为 /etc/tunnel-server-go/tunnel-server.env 并编辑
# 配置覆盖顺序: 默认值 < 此文件 < 同名 OS 环境变量

# 管理端口 (HTTP API + Admin UI)
TUNNEL_MANAGEMENT_ADDR=:8088

# 控制通道 TCP 端口
TUNNEL_NETTY_PORT=7010

# 数据库
# 可选: sqlite / postgres / mysql
TUNNEL_DB_PROVIDER=sqlite
TUNNEL_CONNECTIONSTRINGS_TUNNEL=/var/lib/tunnel-server-go/shuai-tunnel.db

# 对于 postgres:
# TUNNEL_DB_PROVIDER=postgres
# TUNNEL_CONNECTIONSTRINGS_TUNNEL=host=127.0.0.1 port=5432 user=postgres password=xxx dbname=shuai_tunnel sslmode=disable

# 对于 mysql:
# TUNNEL_DB_PROVIDER=mysql
# TUNNEL_CONNECTIONSTRINGS_TUNNEL=root:xxx@tcp(127.0.0.1:3306)/shuai_tunnel?charset=utf8mb4&parseTime=True

# TLS
TUNNEL_TLS_MODE=disabled
# TUNNEL_TLS_CERT_FILE=/etc/tunnel-server-go/tls/cert.pem
# TUNNEL_TLS_KEY_FILE=/etc/tunnel-server-go/tls/key.pem

# 管理员登录
TUNNEL_AUTH_ADMIN_USERNAME=admin
TUNNEL_AUTH_ADMIN_PASSWORD_HASH=

# 客户端认证限制
TUNNEL_CLIENT_AUTH_RATE_LIMIT_PER_MINUTE=30
TUNNEL_CLIENT_AUTH_MAX_ONLINE_INSTANCES=2

# Peer Mesh 组网
TUNNEL_PEER_MESH_ENABLED=false
# TUNNEL_PEER_MESH_CIDR=100.96.0.0/11
# TUNNEL_PEER_MESH_STUN_TURN_PORT=3478
# TUNNEL_PEER_MESH_SESSION_TTL_SECONDS=3600

# 客户端下载链接配置
TUNNEL_JAVA_CLIENT_PACKAGE_URL=
TUNNEL_JAVA_CLIENT_INSTALL_SCRIPT=
TUNNEL_GO_CLIENT_PACKAGE_URL=
TUNNEL_GO_CLIENT_INSTALL_SCRIPT=
TUNNEL_CSHARP_CLIENT_PACKAGE_URL=
TUNNEL_CSHARP_CLIENT_INSTALL_SCRIPT=