# Go Server 环境变量模板
# 复制为 /etc/specus-server-go/specus-server.env 并编辑
# 配置覆盖顺序: 默认值 < 此文件 < 同名 OS 环境变量

# 管理端口 (HTTP API + Admin UI)
SPECUS_MANAGEMENT_ADDR=:8088

# systemd 已捕获完整 stdout/stderr；独立运行二进制时可填写绝对路径启用文件双写
SPECUS_LOG_FILE=

# 控制通道 TCP 端口
SPECUS_NETTY_PORT=7010
# 完整控制帧上限（11 字节 header + body）
SPECUS_NETTY_MAX_FRAME_SIZE=33554432

# 数据库
# 可选: sqlite / postgres / mysql
SPECUS_DB_PROVIDER=sqlite
SPECUS_CONNECTIONSTRINGS_SPECUS=/var/lib/specus-server-go/specus.db

# 对于 postgres:
# SPECUS_DB_PROVIDER=postgres
# SPECUS_CONNECTIONSTRINGS_SPECUS=host=127.0.0.1 port=5432 user=postgres password=xxx dbname=specus sslmode=disable

# 对于 mysql:
# SPECUS_DB_PROVIDER=mysql
# SPECUS_CONNECTIONSTRINGS_SPECUS=root:xxx@tcp(127.0.0.1:3306)/specus?charset=utf8mb4&parseTime=True

# TLS
SPECUS_TLS_MODE=disabled
# SPECUS_TLS_CERT_FILE=/etc/specus-server-go/tls/cert.pem
# SPECUS_TLS_KEY_FILE=/etc/specus-server-go/tls/key.pem

# 管理员登录
SPECUS_AUTH_PASSWORD_LOGIN_ENABLED=true
SPECUS_AUTH_REGISTRATION_ENABLED=false
SPECUS_AUTH_USERNAME=admin
SPECUS_AUTH_PASSWORD=change-me-before-exposure
SPECUS_AUTH_TENANT_ID=default
SPECUS_AUTH_JWT_SECRET=replace-with-a-long-random-secret
SPECUS_AUTH_TOKEN_TTL_SECONDS=28800

# Cloudflare Turnstile（自助注册要求启用并配置完整）
SPECUS_AUTH_TURNSTILE_ENABLED=false
SPECUS_AUTH_TURNSTILE_SITE_KEY=
SPECUS_AUTH_TURNSTILE_SECRET_KEY=
SPECUS_AUTH_TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
SPECUS_AUTH_TURNSTILE_ALLOWED_HOSTNAMES=specus.example.com

# 注册邮箱二次验证
SPECUS_AUTH_EMAIL_VERIFICATION_ENABLED=false
SPECUS_AUTH_EMAIL_FROM_ADDRESS=
SPECUS_AUTH_EMAIL_FROM_NAME=specus
SPECUS_AUTH_EMAIL_SUBJECT=specus 注册验证码
SPECUS_AUTH_EMAIL_CODE_TTL_SECONDS=600
SPECUS_AUTH_EMAIL_MAX_ATTEMPTS=5
SPECUS_AUTH_EMAIL_RESEND_COOLDOWN_SECONDS=60
SPECUS_AUTH_EMAIL_CLEANUP_INTERVAL_MS=3600000
SPECUS_AUTH_SMTP_HOST=
SPECUS_AUTH_SMTP_PORT=587
SPECUS_AUTH_SMTP_USERNAME=
SPECUS_AUTH_SMTP_PASSWORD=
SPECUS_AUTH_SMTP_STARTTLS=true
SPECUS_AUTH_SMTP_STARTTLS_REQUIRED=true
SPECUS_AUTH_SMTP_SSL=false

# 客户端认证限制
SPECUS_CLIENT_AUTH_DEFAULT_MAX_ONLINE_INSTANCES=2
SPECUS_CLIENT_AUTH_PER_MACHINE_USER_MAX_INSTANCES=1
SPECUS_CLIENT_AUTH_TOKEN_TTL_SECONDS=28800

# HTTP body 解压预览安全上限
SPECUS_TRAFFIC_CAPTURE_DECODE_MAX_BYTES=1048576

# Peer Mesh 组网
SPECUS_PEER_MESH_ENABLED=false
# SPECUS_PEER_MESH_CIDR=100.96.0.0/11
# SPECUS_PEER_MESH_PUBLIC_ADDRESS=specus.example.com
# SPECUS_PEER_MESH_STUN_TURN_PORT=3478
# SPECUS_PEER_MESH_NAT_PROBE_ALTERNATE_PORT=3479
# SPECUS_PEER_MESH_PUBLIC_STUN_SERVERS=stun:stun.cloudflare.com:3478,stun:stun.l.google.com:19302
# SPECUS_PEER_MESH_SESSION_TTL_SECONDS=3600
# SPECUS_PEER_MESH_ALLOCATION_TTL_SECONDS=300
# SPECUS_PEER_MESH_SESSION_CLEANUP_INTERVAL_MS=60000
# SPECUS_PEER_MESH_RELAY_MIN_PORT=49152
# SPECUS_PEER_MESH_RELAY_MAX_PORT=65535
# SPECUS_PEER_MESH_RELAY_WORKER_THREADS=0
# SPECUS_PEER_MESH_RELAY_WORKER_QUEUE_CAPACITY=10000
# SPECUS_PEER_MESH_RELAY_TRAFFIC_FLUSH_INTERVAL_MS=5000
# TURN 默认要求短期凭据认证；生产环境必须配置稳定共享密钥，避免重启后旧凭据立即失效。
# SPECUS_PEER_MESH_TURN_AUTH_REQUIRED=true
# SPECUS_PEER_MESH_TURN_REALM=specus
# SPECUS_PEER_MESH_TURN_SHARED_SECRET=replace-with-a-long-random-secret
# SPECUS_PEER_MESH_TURN_CREDENTIAL_TTL_SECONDS=3600

# ---- 通用中继配额（公开互传的浏览器 WebRTC 使用 TURN 时生效）----
# 浏览器经 TURN 转发 DTLS/SRTP，无法通过 Peer Mesh 专用校验，因此这类 allocation 按标准
# TURN 语义放行，目的地址被限制为公网单播（拒绝回环/内网/CGNAT/组播/ULA）。
# 以下配额避免它被当作开放中继刷带宽；MAX_ALLOCATIONS 设为 0 可完全关闭通用中继。
SPECUS_PEER_MESH_GENERAL_RELAY_MAX_ALLOCATIONS=256
SPECUS_PEER_MESH_GENERAL_RELAY_MAX_ALLOCATIONS_PER_ADDRESS=4
SPECUS_PEER_MESH_GENERAL_RELAY_MAX_BYTES=536870912

# 公共文件互传附件（默认关闭；启用时直传私有 Aliyun OSS）
# SPECUS_OBJECT_STORAGE_PROVIDER=aliyun-oss
# SPECUS_OBJECT_STORAGE_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# SPECUS_OBJECT_STORAGE_REGION=cn-hangzhou
# SPECUS_OBJECT_STORAGE_BUCKET=your-private-bucket
# SPECUS_OBJECT_STORAGE_ACCESS_KEY_ID=
# SPECUS_OBJECT_STORAGE_ACCESS_KEY_SECRET=
# SPECUS_OBJECT_STORAGE_PREFIX=specus/attachments
# SPECUS_OBJECT_STORAGE_UPLOAD_CALLBACK_URL=https://specus.devshuai.com/api/public/transfer/oss-callback
# SPECUS_OBJECT_STORAGE_UPLOAD_URL_TTL_SECONDS=900
# SPECUS_OBJECT_STORAGE_DOWNLOAD_URL_TTL_SECONDS=600
# SPECUS_OBJECT_STORAGE_DOWNLOAD_OBJECT_URL_TTL_SECONDS=30
# SPECUS_OBJECT_STORAGE_RETENTION_HOURS=72
# SPECUS_OBJECT_STORAGE_MAX_ATTACHMENT_BYTES=536870912
# SPECUS_OBJECT_STORAGE_PER_USER_STORAGE_QUOTA_BYTES=1073741824
# SPECUS_OBJECT_STORAGE_PER_USER_MONTHLY_DOWNLOAD_QUOTA_BYTES=1073741824
# SPECUS_OBJECT_STORAGE_EXPIRATION_SCAN_INTERVAL_MS=3600000
# SPECUS_PUBLIC_TRANSFER_PRESIGN_RATE_LIMIT_PER_IP=30
# SPECUS_PUBLIC_TRANSFER_PRESIGN_RATE_LIMIT_WINDOW_SECONDS=300
# SPECUS_PUBLIC_TRANSFER_MAX_PENDING_UPLOADS_PER_ROOM=50
# SPECUS_PUBLIC_TRANSFER_MAX_DISCOVERY_PEERS_PER_ROOM=32
# SPECUS_PUBLIC_TRANSFER_DISCOVERY_MESSAGE_RATE_LIMIT_PER_CONNECTION=120
# SPECUS_PUBLIC_TRANSFER_DISCOVERY_MESSAGE_RATE_LIMIT_WINDOW_SECONDS=60

# 客户端下载链接配置
SPECUS_JAVA_CLIENT_PACKAGE_URL=
SPECUS_JAVA_CLIENT_INSTALL_SCRIPT=
SPECUS_GO_CLIENT_PACKAGE_URL=
SPECUS_GO_CLIENT_INSTALL_SCRIPT=
SPECUS_CSHARP_CLIENT_PACKAGE_URL=
SPECUS_CSHARP_CLIENT_INSTALL_SCRIPT=
