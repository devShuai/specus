# =============================================================================
# tunnel-server 环境变量配置示例
# =============================================================================
# 该文件被 systemd 通过 EnvironmentFile 加载，部署时复制为
# /etc/tunnel-server/tunnel-server.env，并 chmod 600（内含数据库密码、JWT 密钥）。
#
# 语法说明：
#   - KEY=VALUE，等号两边不要有空格
#   - 值不需要加引号；如果值里有空格 / 特殊字符，systemd 支持 KEY="value with spaces"
#   - 不支持 shell 变量展开（如 $HOME），直接写完整字面量
#   - 行首 # 为注释
# =============================================================================


# ------------------------------ 数据库（MySQL） ------------------------------
# 把 SQLite 默认值替换成 MySQL。线上建议同时给 tunnel-server 创建独立账号：
#   CREATE DATABASE tunnel CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'tunnel'@'%' IDENTIFIED BY 'CHANGE_ME_STRONG_PASSWORD';
#   GRANT ALL PRIVILEGES ON tunnel.* TO 'tunnel'@'%';
#   FLUSH PRIVILEGES;
#
# JDBC URL 必备参数：
#   useUnicode=true + characterEncoding=UTF-8
#       注意：JDBC 这一层用的是 Java 字符集名（UTF-8），不是 MySQL 服务端的 utf8mb4。
#       写成 characterEncoding=utf8mb4 会启动失败：Unsupported character encoding 'utf8mb4'。
#   connectionCollation=utf8mb4_unicode_ci
#       让会话级别 collation 使用 utf8mb4，配合服务端建库时的 utf8mb4 即可正确存储 emoji / 中文。
#   useSSL=false：内网部署时关闭；公网请改为 true 并配置 trustStore
#   serverTimezone=Asia/Shanghai：避免 mysql-connector-j 取错时区
#   allowPublicKeyRetrieval=true：使用 caching_sha2_password（MySQL 8 默认）时需要
TUNNEL_DB_URL=jdbc:mysql://127.0.0.1:3306/tunnel?useUnicode=true&characterEncoding=UTF-8&connectionCollation=utf8mb4_unicode_ci&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
TUNNEL_DB_DRIVER=com.mysql.cj.jdbc.Driver
TUNNEL_DB_USERNAME=tunnel
TUNNEL_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
TUNNEL_DB_DIALECT=org.hibernate.dialect.MySQLDialect

# Hikari 连接池：MySQL 推荐 16~32，按机器并发量调整
TUNNEL_DB_POOL_SIZE=16
# Hibernate 批处理大小（流量统计 flush / 历史归档 bulk delete 用）
TUNNEL_DB_BATCH_SIZE=50

# 是否在数据库为空时自动写入一条 demo 客户端（便于首次体验）。
# 生产环境建议改为 false，避免产生无主记录。
TUNNEL_DB_SEED_DEMO_CLIENT=false


# ------------------------------ HTTP / 管理端口 ------------------------------
# 管理 UI 与 admin API 端口
# server.port 不在 application.yml 里走 ${} 语法，因此使用 Spring 标准的 SERVER_PORT
SERVER_PORT=8088

# HTTP 直转等待客户端响应的超时时间（毫秒）
TUNNEL_HTTP_TIMEOUT_MS=30000
# HTTP 直转单次请求体最大值（字节），默认 16 MiB
TUNNEL_HTTP_MAX_REQUEST_BODY_SIZE=16777216


# ------------------------------ Netty 控制 / 远端 ------------------------------
# 控制信道（client 与 server 长连接）端口
TUNNEL_NETTY_PORT=7010
# 0 表示交给 Netty 默认（CPU * 2）
#TUNNEL_NETTY_BOSS_THREADS=1
#TUNNEL_NETTY_WORKER_THREADS=0
#TUNNEL_NETTY_REMOTE_BOSS_THREADS=1
#TUNNEL_NETTY_REMOTE_WORKER_THREADS=0
#TUNNEL_NETTY_SO_BACKLOG=8192
#TUNNEL_NETTY_REUSE_ADDRESS=true
#TUNNEL_NETTY_KEEP_ALIVE=true
#TUNNEL_NETTY_TCP_NO_DELAY=true
#TUNNEL_NETTY_WRITE_BUFFER_LOW_WATER_MARK=32768
#TUNNEL_NETTY_WRITE_BUFFER_HIGH_WATER_MARK=65536
#TUNNEL_NETTY_MAX_FRAME_SIZE=33554432
# 并发上限
#TUNNEL_NETTY_MAX_EXTERNAL_CONNECTIONS=10000
#TUNNEL_NETTY_MAX_EXTERNAL_CONNECTIONS_PER_CLIENT=10000
#TUNNEL_NETTY_MAX_EXTERNAL_CONNECTIONS_PER_PORT=10000

# 客户端在隧道里使用的对外可见地址；留空则取请求侧推断
# 注意：若服务器在反向代理 / NAT 后面，必须显式配置成对外可达的域名或 IP
#TUNNEL_PUBLIC_ADDRESS=tunnel.example.com


# ------------------------------ 管理后台登录 ------------------------------
# 内置用户名 / 密码登录开关；如果只走 OIDC 可以关掉
TUNNEL_AUTH_PASSWORD_LOGIN_ENABLED=true
TUNNEL_AUTH_USERNAME=admin
# 上线前务必修改默认密码
TUNNEL_AUTH_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
# 本地密码登录签发 JWT 时使用的默认租户
TUNNEL_AUTH_TENANT_ID=default
# JWT 签名密钥（base64 编码的随机 256 位字符串），留空时启动会自动生成但每次重启失效
# 生成示例：openssl rand -base64 48
TUNNEL_AUTH_JWT_SECRET=
# Token 有效期（秒），默认 8 小时
TUNNEL_AUTH_TOKEN_TTL_SECONDS=28800


# ------------------------------ 客户端认证 / 在线实例限制 ------------------------------
# 同一用户 + 同一机器默认只允许 1 个客户端进程在线
TUNNEL_CLIENT_AUTH_PER_MACHINE_USER_MAX_INSTANCES=1
# 每个客户端账号默认最多同时在线实例数
TUNNEL_CLIENT_AUTH_DEFAULT_MAX_ONLINE_INSTANCES=2
# 客户端访问令牌有效期（秒）；客户端会在快过期时刷新，尽量不中断隧道
TUNNEL_CLIENT_AUTH_TOKEN_TTL_SECONDS=28800


# ------------------------------ 私有组网 / Peer Mesh（默认关闭） ------------------------------
# 同一租户 / 同一用户下多个客户端组成私有 mesh 网络。默认关闭，开启后服务端会在客户端
# HTTP 登录响应中下发虚拟 IP、网段、STUN/TURN-lite 地址与会话授权信息。
TUNNEL_PEER_MESH_ENABLED=false
# 默认 mesh 网段；服务端会按用户分配子网、按客户端分配 /32 虚拟 IP
TUNNEL_PEER_MESH_CIDR=100.96.0.0/11
# Peer UDP 探测 / relay 对外可达地址；留空时优先使用 TUNNEL_PUBLIC_ADDRESS 或请求推断地址。
# 服务器在 NAT / 反向代理后面时建议显式填写公网 IP 或域名。
#TUNNEL_PEER_MESH_PUBLIC_ADDRESS=tunnel.example.com
# 内置 STUN/TURN-lite UDP 端口。启用 peer mesh 后需要在防火墙放行 UDP。
TUNNEL_PEER_MESH_STUN_TURN_PORT=3478
# NAT 类型辅助探测 UDP 端口。0 表示默认使用 STUN/TURN-lite 端口 + 1。
# 开启 peer mesh 后建议同时放行该 UDP 端口，用于尽量识别 symmetric / port-restricted NAT。
TUNNEL_PEER_MESH_NAT_PROBE_ALTERNATE_PORT=0
# peer session 授权有效期；过期后 relay 会拒绝转发，新会话需要重新授权
TUNNEL_PEER_MESH_SESSION_TTL_SECONDS=3600
# relay allocation TTL；客户端会周期刷新 allocation
TUNNEL_PEER_MESH_ALLOCATION_TTL_SECONDS=300
# relay 数据帧工作线程。0 表示按 CPU 自动选择，控制面 binding/allocate 不走该线程池。
TUNNEL_PEER_MESH_RELAY_WORKER_THREADS=0
# relay 数据帧工作队列上限；队列满时丢弃新的 relay 数据帧，保护服务端。
TUNNEL_PEER_MESH_RELAY_WORKER_QUEUE_CAPACITY=10000
# relay 流量聚合入库间隔（毫秒）
TUNNEL_PEER_MESH_RELAY_TRAFFIC_FLUSH_INTERVAL_MS=5000


# ------------------------------ OIDC 登录（可选） ------------------------------
# 若不使用 OIDC，把 client-id 留空即可禁用
#TUNNEL_OIDC_ISSUER=https://gateway.example.com/auth
#TUNNEL_OIDC_JWK_SET_URI=https://gateway.example.com/auth/oauth2/jwks
#TUNNEL_OIDC_AUTHORIZATION_ENDPOINT=https://gateway.example.com/auth/oauth2/authorize
#TUNNEL_OIDC_TOKEN_ENDPOINT=https://gateway.example.com/auth/oauth2/token
#TUNNEL_OIDC_END_SESSION_ENDPOINT=https://gateway.example.com/auth/connect/logout
#TUNNEL_OIDC_CLIENT_ID=
#TUNNEL_OIDC_CLIENT_SECRET=
#TUNNEL_OIDC_REDIRECT_URI=https://tunnel.example.com/
#TUNNEL_OIDC_SCOPE=openid
#TUNNEL_OIDC_AUDIENCE=
#TUNNEL_OIDC_TENANT_CLAIM=tenant_id


# ------------------------------ 流量统计 / 明细采集 / 归档 ------------------------------
# 流量计数 flush 间隔（毫秒）
#TUNNEL_TRAFFIC_FLUSH_INTERVAL_MS=5000
# 明细采集总开关；关闭后只保留聚合流量。每条 HTTP 路由 / TCP 映射仍需在管理页单独开启，
# 新建通道默认关闭明细采集。
TUNNEL_TRAFFIC_CAPTURE_DETAIL_ENABLED=false
# 列表页短预览长度；TCP 会另外保存完整二进制 payload
TUNNEL_TRAFFIC_CAPTURE_PREVIEW_BYTES=256
# Header 保存字符上限，避免异常超大 Header 撑爆明细
TUNNEL_TRAFFIC_CAPTURE_HEADER_CHARS=8192
# 压缩 HTTP Body 解压预览上限，避免异常压缩包占用过多内存
TUNNEL_TRAFFIC_CAPTURE_DECODE_MAX_BYTES=1048576
# 内存中待写入明细队列上限；达到上限会丢弃新明细，保护主链路
TUNNEL_TRAFFIC_CAPTURE_MAX_PENDING=20000
# 每次 flush 的明细批量大小
TUNNEL_TRAFFIC_CAPTURE_FLUSH_BATCH_SIZE=1000
# 明细 flush 间隔（毫秒）
TUNNEL_TRAFFIC_CAPTURE_FLUSH_INTERVAL_MS=2000
# 连接明细保留天数；超过的明细会按月汇总后删除。0 关闭归档
#TUNNEL_CONNECTION_DETAIL_RETENTION_DAYS=60
# 归档任务执行间隔（毫秒）
#TUNNEL_CONNECTION_ARCHIVE_INTERVAL_MS=3600000


# ------------------------------ Elasticsearch 流量明细存储（可选） ------------------------------
# 留空时 HTTP/TCP 明细写入业务数据库；配置后自动切换到 Elasticsearch。
# 多节点用逗号分隔，例如：http://es-a:9200,http://es-b:9200
#TUNNEL_ELASTICSEARCH_URIS=http://127.0.0.1:9200
#TUNNEL_ELASTICSEARCH_USERNAME=elastic
#TUNNEL_ELASTICSEARCH_PASSWORD=CHANGE_ME_ES_PASSWORD
# 如果使用 API Key，填写后优先使用 api-key，username/password 可留空
#TUNNEL_ELASTICSEARCH_API_KEY=
#TUNNEL_ELASTICSEARCH_HTTP_INDEX=shuai-tunnel-http-traffic
#TUNNEL_ELASTICSEARCH_TCP_INDEX=shuai-tunnel-tcp-traffic
# HTTP 协议明细索引最大存储体积，默认 100GB；TCP payload 索引默认 10GB
#TUNNEL_ELASTICSEARCH_HTTP_MAX_STORE_SIZE=100GB
#TUNNEL_ELASTICSEARCH_TCP_MAX_STORE_SIZE=10GB


# ------------------------------ 登录链路线程池 ------------------------------
# 鉴权、连接记录写入、NAT_CONTROL 下发使用独立线程池，避免阻塞 Netty I/O 线程
#TUNNEL_LOGIN_EXECUTOR_CORE=8
#TUNNEL_LOGIN_EXECUTOR_MAX=32
#TUNNEL_LOGIN_EXECUTOR_QUEUE=20000


# ------------------------------ 控制信道 TLS ------------------------------
# disabled / file / self-signed
TUNNEL_TLS_MODE=disabled
#TUNNEL_TLS_KEYSTORE=/etc/tunnel-server/keystore.p12
#TUNNEL_TLS_KEYSTORE_PASSWORD=
#TUNNEL_TLS_KEY_PASSWORD=


# ------------------------------ JVM 参数 ------------------------------
# 透传给 systemd 单元中的 ExecStart，建议根据机器内存设置堆上限
JAVA_OPTS=-Xms256m -Xmx1024m -XX:+UseG1GC -Dfile.encoding=UTF-8
