# =============================================================================
# specus-server 环境变量配置示例
# =============================================================================
# 该文件被 systemd 通过 EnvironmentFile 加载，部署时复制为
# /etc/specus-server/specus-server.env，并 chmod 600（内含数据库密码、JWT 密钥）。
#
# 语法说明：
#   - KEY=VALUE，等号两边不要有空格
#   - 值不需要加引号；如果值里有空格 / 特殊字符，systemd 支持 KEY="value with spaces"
#   - 不支持 shell 变量展开（如 $HOME），直接写完整字面量
#   - 行首 # 为注释
# =============================================================================


# ------------------------------ 数据库（MySQL） ------------------------------
# 把 SQLite 默认值替换成 MySQL。线上建议同时给 specus-server 创建独立账号：
#   CREATE DATABASE specus CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'specus'@'%' IDENTIFIED BY 'CHANGE_ME_STRONG_PASSWORD';
#   GRANT ALL PRIVILEGES ON specus.* TO 'specus'@'%';
#   FLUSH PRIVILEGES;
#
# JDBC URL 必备参数：
#   useUnicode=true + characterEncoding=UTF-8
#       注意：JDBC 这一层用的是 Java 字符集名（UTF-8），不是 MySQL 服务端的 utf8mb4。
#       写成 characterEncoding=utf8mb4 会启动失败：Unsupported character encoding 'utf8mb4'。
#   connectionCollation=utf8mb4_unicode_ci
#       让会话级别 collation 使用 utf8mb4，配合服务端建库时的 utf8mb4 即可正确存储 emoji / 中文。
#   useSSL=false：内网部署时关闭；公网请改为 true 并配置 trustStore
#   serverTimezone=Asia/Shanghai：避免 mysql-connector-j 取错时区
#   allowPublicKeyRetrieval=true：使用 caching_sha2_password（MySQL 8 默认）时需要
SPECUS_DB_URL=jdbc:mysql://127.0.0.1:3306/specus?useUnicode=true&characterEncoding=UTF-8&connectionCollation=utf8mb4_unicode_ci&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
SPECUS_DB_DRIVER=com.mysql.cj.jdbc.Driver
SPECUS_DB_USERNAME=specus
SPECUS_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
SPECUS_DB_DIALECT=org.hibernate.dialect.MySQLDialect

# Hikari 连接池：MySQL 推荐 16~32，按机器并发量调整
SPECUS_DB_POOL_SIZE=16
# Hibernate 批处理大小（流量统计 flush / 历史归档 bulk delete 用）
SPECUS_DB_BATCH_SIZE=50

# 是否在数据库为空时自动写入一条 demo 客户端（便于首次体验）。
# 生产环境建议改为 false，避免产生无主记录。
SPECUS_DB_SEED_DEMO_CLIENT=false


# ------------------------------ HTTP / 管理端口 ------------------------------
# 管理 UI 与 admin API 端口
# server.port 不在 application.yml 里走 ${} 语法，因此使用 Spring 标准的 SERVER_PORT
SERVER_PORT=8088

# Linux 文件日志。systemd unit 已提供同样的默认路径，保留这些配置便于按环境覆盖。
# 当前日志达到 50MB 或跨日期时滚动并 gzip 压缩，最多保留 30 个历史周期且总量不超过 2GB。
SPECUS_LOG_FILE=/var/log/specus-server/specus-server.log
SPECUS_LOG_MAX_FILE_SIZE=50MB
SPECUS_LOG_MAX_HISTORY=30
SPECUS_LOG_TOTAL_SIZE_CAP=2GB
SPECUS_LOG_CLEAN_HISTORY_ON_START=true

# HTTP 直转等待客户端响应的超时时间（毫秒）
SPECUS_HTTP_TIMEOUT_MS=30000
# HTTP 直转单次请求体最大值（字节），默认 16 MiB
SPECUS_HTTP_MAX_REQUEST_BODY_SIZE=16777216


# ------------------------------ Netty 控制 / 远端 ------------------------------
# 控制信道（client 与 server 长连接）端口
SPECUS_NETTY_PORT=7010
# 0 表示交给 Netty 默认（CPU * 2）
#SPECUS_NETTY_BOSS_THREADS=1
#SPECUS_NETTY_WORKER_THREADS=0
#SPECUS_NETTY_REMOTE_BOSS_THREADS=1
#SPECUS_NETTY_REMOTE_WORKER_THREADS=0
#SPECUS_NETTY_SO_BACKLOG=8192
#SPECUS_NETTY_REUSE_ADDRESS=true
#SPECUS_NETTY_KEEP_ALIVE=true
#SPECUS_NETTY_TCP_NO_DELAY=true
#SPECUS_NETTY_WRITE_BUFFER_LOW_WATER_MARK=32768
#SPECUS_NETTY_WRITE_BUFFER_HIGH_WATER_MARK=65536
#SPECUS_NETTY_MAX_FRAME_SIZE=33554432
# 并发上限
#SPECUS_NETTY_MAX_EXTERNAL_CONNECTIONS=10000
#SPECUS_NETTY_MAX_EXTERNAL_CONNECTIONS_PER_CLIENT=10000
#SPECUS_NETTY_MAX_EXTERNAL_CONNECTIONS_PER_PORT=10000

# 客户端在隧道里使用的对外可见地址；留空则取请求侧推断
# 注意：若服务器在反向代理 / NAT 后面，必须显式配置成对外可达的域名或 IP
#SPECUS_PUBLIC_ADDRESS=specus.example.com


# ------------------------------ 管理后台登录 ------------------------------
# 内置用户名 / 密码登录开关；如果只走 OIDC 可以关掉
SPECUS_AUTH_PASSWORD_LOGIN_ENABLED=true
# 自助注册还要求下方 Turnstile、邮箱验证与 SMTP 全部配置完成
SPECUS_AUTH_REGISTRATION_ENABLED=false
SPECUS_AUTH_USERNAME=admin
# 上线前务必修改默认密码
SPECUS_AUTH_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
# 本地密码登录签发 JWT 时使用的默认租户
SPECUS_AUTH_TENANT_ID=default
# JWT 签名密钥（base64 编码的随机 256 位字符串），留空时启动会自动生成但每次重启失效
# 生成示例：openssl rand -base64 48
SPECUS_AUTH_JWT_SECRET=
# Token 有效期（秒），默认 8 小时
SPECUS_AUTH_TOKEN_TTL_SECONDS=28800

# Cloudflare Turnstile：启用后本地密码登录必须携带有效 login action token
SPECUS_AUTH_TURNSTILE_ENABLED=false
SPECUS_AUTH_TURNSTILE_SITE_KEY=
SPECUS_AUTH_TURNSTILE_SECRET_KEY=
SPECUS_AUTH_TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
# 必填，逗号分隔；必须与 Turnstile 控制台授权的管理站点域名一致
SPECUS_AUTH_TURNSTILE_ALLOWED_HOSTNAMES=specus.example.com

# 注册邮箱二次验证
SPECUS_AUTH_EMAIL_VERIFICATION_ENABLED=false
SPECUS_AUTH_EMAIL_FROM_ADDRESS=
SPECUS_AUTH_EMAIL_FROM_NAME=specus
SPECUS_AUTH_EMAIL_SUBJECT=specus 注册验证码
SPECUS_AUTH_EMAIL_CODE_TTL_SECONDS=600
SPECUS_AUTH_EMAIL_MAX_ATTEMPTS=5
SPECUS_AUTH_EMAIL_RESEND_COOLDOWN_SECONDS=60
SPECUS_AUTH_EMAIL_CLEANUP_INTERVAL_MS=3600000

# SMTP（587 + STARTTLS 示例；465 端口通常改为 SMTP_SSL=true、STARTTLS=false）
SPECUS_AUTH_SMTP_HOST=
SPECUS_AUTH_SMTP_PORT=587
SPECUS_AUTH_SMTP_USERNAME=
SPECUS_AUTH_SMTP_PASSWORD=
SPECUS_AUTH_SMTP_AUTH=true
SPECUS_AUTH_SMTP_STARTTLS=true
SPECUS_AUTH_SMTP_STARTTLS_REQUIRED=true
SPECUS_AUTH_SMTP_SSL=false


# ------------------------------ 客户端认证 / 在线实例限制 ------------------------------
# 同一用户 + 同一机器默认只允许 1 个客户端进程在线
SPECUS_CLIENT_AUTH_PER_MACHINE_USER_MAX_INSTANCES=1
# 每个客户端账号默认最多同时在线实例数
SPECUS_CLIENT_AUTH_DEFAULT_MAX_ONLINE_INSTANCES=2
# 客户端访问令牌有效期（秒）；客户端会在快过期时刷新，尽量不中断隧道
SPECUS_CLIENT_AUTH_TOKEN_TTL_SECONDS=28800


# ------------------------------ 私有组网 / Peer Mesh（默认关闭） ------------------------------
# 同一租户 / 同一用户下多个客户端组成私有 mesh 网络。默认关闭，开启后服务端会在客户端
# HTTP 登录响应中下发虚拟 IP、网段、标准 STUN/TURN 地址与会话授权信息。
SPECUS_PEER_MESH_ENABLED=false
# 默认 mesh 网段；服务端会按用户分配子网、按客户端分配 /32 虚拟 IP
SPECUS_PEER_MESH_CIDR=100.96.0.0/11
# Peer UDP 探测 / relay 对外可达地址；留空时优先使用 SPECUS_PUBLIC_ADDRESS 或请求推断地址。
# 服务器在 NAT / 反向代理后面时建议显式填写公网 IP 或域名。
#SPECUS_PEER_MESH_PUBLIC_ADDRESS=specus.example.com
# 内置标准 STUN/TURN UDP 控制端口。启用 peer mesh 后需要在防火墙放行 UDP。
SPECUS_PEER_MESH_STUN_TURN_PORT=3478
# 可选：独立 RFC 5780 STUN 主入口。配置后客户端的 stunHost/stunPort 和公开 STUN
# 配置优先使用该端点；TURN 仍使用 SPECUS_PEER_MESH_PUBLIC_ADDRESS:STUN_TURN_PORT。
#SPECUS_PEER_MESH_STANDALONE_STUN_ADDRESS=stun1.specus.devshuai.com
#SPECUS_PEER_MESH_STANDALONE_STUN_PORT=34780
# 可选：独立 RFC 5780 服务的 A2 地址和 P2 端口。A2:P1 会作为客户端备用 STUN
# 自动下发；四个变量还会生成 A1:P1、A1:P2、A2:P1、A2:P2 NAT 探测拓扑。
#SPECUS_PEER_MESH_STANDALONE_STUN_ALTERNATE_ADDRESS=stun2.specus.devshuai.com
#SPECUS_PEER_MESH_STANDALONE_STUN_ALTERNATE_PORT=34781
# NAT 类型辅助探测 UDP 端口。默认 3479，建议与主 STUN/TURN 端口一起放行。
# 开启 peer mesh 后建议同时放行该 UDP 端口，用于尽量识别 symmetric / port-restricted NAT。
SPECUS_PEER_MESH_NAT_PROBE_ALTERNATE_PORT=3479
# 可选：在 specus-server 内启用完整 RFC 5780 四端点 Binding。
# SPECUS_PEER_MESH_PUBLIC_ADDRESS 此时必须填写主公网 IP A1，不能使用多 A 记录域名；
# primary/alternate bind address 是本机实际拥有的 A1/A2 地址，可以分别通过 1:1 NAT 映射到两个公网 IP。
# TURN Allocate/Refresh/CreatePermission 仍只在 A1:P1 提供，其他三个端点只处理 STUN Binding。
#SPECUS_PEER_MESH_STUN_PRIMARY_BIND_ADDRESS=10.0.0.10
#SPECUS_PEER_MESH_STUN_ALTERNATE_BIND_ADDRESS=10.0.0.11
#SPECUS_PEER_MESH_STUN_ALTERNATE_PUBLIC_ADDRESS=203.0.113.11
# 完整模式建议开启；配置不完整时直接阻止内置 STUN/TURN 启动。
#SPECUS_PEER_MESH_STUN_BEHAVIOR_STRICT=true
# 额外公共 STUN 服务器，只用于补充 server-reflexive candidate，不提供 relay。
# 多个地址用英文逗号分隔，支持 host:port / stun:host:port；未写端口时默认 3478。
#SPECUS_PEER_MESH_PUBLIC_STUN_SERVERS=stun.example.com:3478,stun2.example.com:3478
# peer session 授权有效期；过期后 relay 会拒绝转发，新会话需要重新授权
SPECUS_PEER_MESH_SESSION_TTL_SECONDS=3600
# relay allocation TTL；客户端会周期刷新 allocation
SPECUS_PEER_MESH_ALLOCATION_TTL_SECONDS=300
# 标准 TURN relay 分配端口范围；公网安全组 / 防火墙需要同步开放 UDP。
SPECUS_PEER_MESH_RELAY_MIN_PORT=49152
SPECUS_PEER_MESH_RELAY_MAX_PORT=65535
# relay 数据帧工作线程。0 表示按 CPU 自动选择，控制面 binding/allocate 不走该线程池。
SPECUS_PEER_MESH_RELAY_WORKER_THREADS=0
# relay 数据帧工作队列上限；队列满时丢弃新的 relay 数据帧，保护服务端。
SPECUS_PEER_MESH_RELAY_WORKER_QUEUE_CAPACITY=10000
# STUN/TURN 与 allocation socket 的 UDP 缓冲区（字节）及 IP_TOS/Traffic Class。
SPECUS_PEER_MESH_UDP_RECEIVE_BUFFER_BYTES=4194304
SPECUS_PEER_MESH_UDP_SEND_BUFFER_BYTES=4194304
SPECUS_PEER_MESH_UDP_TRAFFIC_CLASS=16
# relay 流量聚合入库间隔（毫秒）
SPECUS_PEER_MESH_RELAY_TRAFFIC_FLUSH_INTERVAL_MS=5000
# TURN Allocate/Refresh/CreatePermission 默认要求长期凭证认证。
SPECUS_PEER_MESH_TURN_AUTH_REQUIRED=true
SPECUS_PEER_MESH_TURN_REALM=specus
# 生产环境应持久配置；留空会使用进程内随机密钥，重启后旧 credential 失效。
#SPECUS_PEER_MESH_TURN_SHARED_SECRET=CHANGE_ME_RANDOM_SECRET
SPECUS_PEER_MESH_TURN_CREDENTIAL_TTL_SECONDS=3600

# ---- 通用中继配额（公开互传的浏览器 WebRTC 使用 TURN 时生效）----
# 浏览器经 TURN 转发 DTLS/SRTP，无法通过 Peer Mesh 专用校验，因此这类 allocation 按标准
# TURN 语义放行，目的地址被限制为公网单播（拒绝回环/内网/CGNAT/组播/ULA）。
# 以下配额用于避免它被当作开放中继刷带宽；设为 0 可完全关闭通用中继（网页端将只能用 STUN）。
SPECUS_PEER_MESH_GENERAL_RELAY_MAX_ALLOCATIONS=256
SPECUS_PEER_MESH_GENERAL_RELAY_MAX_ALLOCATIONS_PER_ADDRESS=4
# 单个 allocation 生命周期内可转发的总字节数，0 表示不限
SPECUS_PEER_MESH_GENERAL_RELAY_MAX_BYTES=536870912


# ------------------------------ 公共互传附件 / 私有 OSS（默认关闭） ------------------------------
# disabled / aliyun-oss。启用后浏览器用短期预签名 URL 直传私有 bucket。
SPECUS_OBJECT_STORAGE_PROVIDER=disabled
#SPECUS_OBJECT_STORAGE_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
#SPECUS_OBJECT_STORAGE_REGION=cn-hangzhou
#SPECUS_OBJECT_STORAGE_BUCKET=your-private-bucket
#SPECUS_OBJECT_STORAGE_ACCESS_KEY_ID=
#SPECUS_OBJECT_STORAGE_ACCESS_KEY_SECRET=
SPECUS_OBJECT_STORAGE_PREFIX=specus/attachments
# OSS 上传成功后回调业务服务；留空时客户端 complete 会继续用 HEAD 确认。
#SPECUS_OBJECT_STORAGE_UPLOAD_CALLBACK_URL=https://specus.devshuai.com/api/public/transfer/oss-callback
SPECUS_OBJECT_STORAGE_UPLOAD_URL_TTL_SECONDS=900
SPECUS_OBJECT_STORAGE_DOWNLOAD_URL_TTL_SECONDS=600
SPECUS_OBJECT_STORAGE_DOWNLOAD_OBJECT_URL_TTL_SECONDS=30
SPECUS_OBJECT_STORAGE_RETENTION_HOURS=72
SPECUS_OBJECT_STORAGE_MAX_ATTACHMENT_BYTES=536870912
SPECUS_OBJECT_STORAGE_PER_USER_STORAGE_QUOTA_BYTES=1073741824
SPECUS_OBJECT_STORAGE_PER_USER_MONTHLY_DOWNLOAD_QUOTA_BYTES=1073741824
SPECUS_OBJECT_STORAGE_EXPIRATION_SCAN_INTERVAL_MS=3600000

# ------------------------------ HTTP 媒体采集 / RustFS（默认关闭） ------------------------------
# 仅在总开关和 HTTP 路由“媒体采集”开关同时启用时采集。服务端使用 RustFS S3 API
# 分片上传，浏览器只访问 specus-server 的短期播放地址，不接触 RustFS 密钥。
SPECUS_MEDIA_CAPTURE_ENABLED=false
# RustFS S3 API 地址，不是管理控制台地址。
#SPECUS_MEDIA_CAPTURE_ENDPOINT=http://127.0.0.1:9000
SPECUS_MEDIA_CAPTURE_REGION=us-east-1
#SPECUS_MEDIA_CAPTURE_BUCKET=specus-media
#SPECUS_MEDIA_CAPTURE_ACCESS_KEY_ID=
#SPECUS_MEDIA_CAPTURE_ACCESS_KEY_SECRET=
SPECUS_MEDIA_CAPTURE_PREFIX=specus/http-media
SPECUS_MEDIA_CAPTURE_PATH_STYLE=true
SPECUS_MEDIA_CAPTURE_CREATE_BUCKET_IF_MISSING=false
# S3 multipart 除最后一片外至少 5 MiB；默认 8 MiB。
SPECUS_MEDIA_CAPTURE_PART_SIZE_BYTES=8388608
SPECUS_MEDIA_CAPTURE_MAX_INFLIGHT_PARTS=4
SPECUS_MEDIA_CAPTURE_UPLOAD_THREADS=4
# 点播/Range 媒体默认保留 7 天；直播分段仍由 LIVE_WINDOW_SECONDS 控制滚动窗口。
SPECUS_MEDIA_CAPTURE_RETENTION_SECONDS=604800
SPECUS_MEDIA_CAPTURE_LIVE_WINDOW_SECONDS=300
SPECUS_MEDIA_CAPTURE_MANIFEST_MAX_BYTES=16777216
SPECUS_MEDIA_CAPTURE_PLAYBACK_TICKET_TTL_SECONDS=900
SPECUS_MEDIA_CAPTURE_CLEANUP_INTERVAL_MS=60000

# 公开 presign-upload 与 discovery 的滥用防护。多实例时启用 Redis 共享状态。
SPECUS_PUBLIC_TRANSFER_PRESIGN_RATE_LIMIT_PER_IP=30
SPECUS_PUBLIC_TRANSFER_PRESIGN_RATE_LIMIT_WINDOW_SECONDS=300
SPECUS_PUBLIC_TRANSFER_MAX_PENDING_UPLOADS_PER_ROOM=50
SPECUS_PUBLIC_TRANSFER_MAX_DISCOVERY_PEERS_PER_ROOM=32
SPECUS_PUBLIC_TRANSFER_DISCOVERY_MESSAGE_RATE_LIMIT_PER_CONNECTION=360
SPECUS_PUBLIC_TRANSFER_DISCOVERY_MESSAGE_RATE_LIMIT_WINDOW_SECONDS=60
# 多实例部署必须配置为 true 并提供可用的 Redis URI；Redis 故障时失败关闭，不回退本地状态。
SPECUS_PUBLIC_TRANSFER_CLUSTER_ENABLED=false
SPECUS_PUBLIC_TRANSFER_REDIS_URI=
SPECUS_PUBLIC_TRANSFER_REDIS_KEY_PREFIX=specus:v2:public-transfer
SPECUS_PUBLIC_TRANSFER_PRESENCE_LEASE_SECONDS=30
SPECUS_PUBLIC_TRANSFER_PRESENCE_REFRESH_INTERVAL_MS=10000
SPECUS_PUBLIC_TRANSFER_REDIS_COMMAND_TIMEOUT_MS=2000
# 8 位一次性配对码：默认 5 分钟有效，每个来源 IP 每 5 分钟最多兑换 10 次。
SPECUS_PUBLIC_TRANSFER_PAIRING_CODE_TTL_SECONDS=300
SPECUS_PUBLIC_TRANSFER_PAIRING_CODE_REDEEM_RATE_LIMIT_PER_IP=10
SPECUS_PUBLIC_TRANSFER_PAIRING_CODE_REDEEM_RATE_LIMIT_WINDOW_SECONDS=300


# ------------------------------ OIDC 登录（可选） ------------------------------
# 若不使用 OIDC，把 client-id 留空即可禁用
#SPECUS_OIDC_ISSUER=https://gateway.example.com/auth
#SPECUS_OIDC_JWK_SET_URI=https://gateway.example.com/auth/oauth2/jwks
#SPECUS_OIDC_AUTHORIZATION_ENDPOINT=https://gateway.example.com/auth/oauth2/authorize
#SPECUS_OIDC_TOKEN_ENDPOINT=https://gateway.example.com/auth/oauth2/token
#SPECUS_OIDC_END_SESSION_ENDPOINT=https://gateway.example.com/auth/connect/logout
#SPECUS_OIDC_CLIENT_ID=
#SPECUS_OIDC_CLIENT_SECRET=
#SPECUS_OIDC_REDIRECT_URI=https://specus.example.com/
#SPECUS_OIDC_SCOPE=openid
#SPECUS_OIDC_AUDIENCE=
#SPECUS_OIDC_TENANT_CLAIM=tenant_id


# ------------------------------ 流量统计 / 明细采集 / 归档 ------------------------------
# 流量计数 flush 间隔（毫秒）
#SPECUS_TRAFFIC_FLUSH_INTERVAL_MS=5000
# 明细采集总开关；关闭后只保留聚合流量。每条 HTTP 路由 / TCP 映射仍需在管理页单独开启，
# 新建通道默认关闭明细采集。
SPECUS_TRAFFIC_CAPTURE_DETAIL_ENABLED=false
# 列表页搜索/摘要的短预览长度；HTTP Body 和 TCP payload 均另外保存完整原始数据
SPECUS_TRAFFIC_CAPTURE_PREVIEW_BYTES=256
# Header 保存字符上限，避免异常超大 Header 撑爆明细
SPECUS_TRAFFIC_CAPTURE_HEADER_CHARS=8192
# 压缩 HTTP Body 解压预览上限，避免异常压缩包占用过多内存
SPECUS_TRAFFIC_CAPTURE_DECODE_MAX_BYTES=1048576
# 内存中待写入明细队列上限；达到上限会丢弃新明细，保护主链路
SPECUS_TRAFFIC_CAPTURE_MAX_PENDING=20000
# 每次 flush 的明细批量大小
SPECUS_TRAFFIC_CAPTURE_FLUSH_BATCH_SIZE=1000
# 明细 flush 间隔（毫秒）
SPECUS_TRAFFIC_CAPTURE_FLUSH_INTERVAL_MS=2000
# 连接明细保留天数；超过的明细会按月汇总后删除。0 关闭归档
#SPECUS_CONNECTION_DETAIL_RETENTION_DAYS=60
# 归档任务执行间隔（毫秒）
#SPECUS_CONNECTION_ARCHIVE_INTERVAL_MS=3600000


# ------------------------------ Elasticsearch 流量明细存储（可选） ------------------------------
# 留空时 HTTP/TCP 明细写入业务数据库；配置后自动切换到 Elasticsearch。
# 多节点用逗号分隔，例如：http://es-a:9200,http://es-b:9200
#SPECUS_ELASTICSEARCH_URIS=http://127.0.0.1:9200
#SPECUS_ELASTICSEARCH_USERNAME=elastic
#SPECUS_ELASTICSEARCH_PASSWORD=CHANGE_ME_ES_PASSWORD
# 如果使用 API Key，填写后优先使用 api-key，username/password 可留空
#SPECUS_ELASTICSEARCH_API_KEY=
#SPECUS_ELASTICSEARCH_HTTP_INDEX=specus-http-traffic
#SPECUS_ELASTICSEARCH_TCP_INDEX=specus-tcp-traffic
# HTTP 协议明细索引最大存储体积，默认 100GB；TCP payload 索引默认 10GB
#SPECUS_ELASTICSEARCH_HTTP_MAX_STORE_SIZE=100GB
#SPECUS_ELASTICSEARCH_TCP_MAX_STORE_SIZE=10GB


# ------------------------------ 登录链路线程池 ------------------------------
# 鉴权、连接记录写入、NAT_CONTROL 下发使用独立线程池，避免阻塞 Netty I/O 线程
#SPECUS_LOGIN_EXECUTOR_CORE=8
#SPECUS_LOGIN_EXECUTOR_MAX=32
#SPECUS_LOGIN_EXECUTOR_QUEUE=20000


# ------------------------------ 控制信道 TLS ------------------------------
# disabled / file / self-signed
SPECUS_TLS_MODE=disabled
#SPECUS_TLS_KEYSTORE=/etc/specus-server/keystore.p12
#SPECUS_TLS_KEYSTORE_PASSWORD=
#SPECUS_TLS_KEY_PASSWORD=


# ------------------------------ JVM 参数 ------------------------------
# 透传给 systemd 单元中的 ExecStart，建议根据机器内存设置堆上限
JAVA_OPTS=-Xms256m -Xmx1024m -XX:+UseG1GC -Dfile.encoding=UTF-8
