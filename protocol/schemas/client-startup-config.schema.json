{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devshuai.com/shuai-tunnel/schemas/client-startup-config.schema.json",
  "title": "shuai-tunnel 客户端启动配置",
  "description": "tunnelClientConfig.json 的跨语言字段约束。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "serverBaseUrl",
    "apiKey",
    "secret"
  ],
  "properties": {
    "serverBaseUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://",
      "description": "服务端管理 HTTP 地址，客户端启动后调用 /api/client/auth/login。"
    },
    "apiKey": {
      "type": "string",
      "minLength": 1,
      "description": "管理后台创建的客户端凭证 key。"
    },
    "secret": {
      "type": "string",
      "minLength": 1,
      "description": "客户端凭证明文，只在创建或重置时展示一次。"
    },
    "peerMeshDevice": {
      "type": "string",
      "default": "noop",
      "enum": [
        "noop",
        "linux-tun",
        "windows-wintun",
        "wintun",
        "auto"
      ],
      "description": "Peer Mesh 虚拟网卡模式。"
    },
    "peerMeshTunName": {
      "type": "string",
      "default": "shuai0",
      "minLength": 1,
      "description": "Peer Mesh 虚拟网卡名称。"
    },
    "peerMeshMtu": {
      "type": "integer",
      "default": 1400,
      "minimum": 576,
      "maximum": 9000,
      "description": "Peer Mesh 虚拟网卡 MTU。"
    }
  }
}
