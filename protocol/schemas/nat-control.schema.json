{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specus.devshuai.com/schemas/nat-control.schema.json",
  "title": "specus NAT_CONTROL",
  "description": "MessageType.NAT_CONTROL 的 JSON 消息体。字段缺省语义见 protocol/spec/control-protocol.md。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "clientName",
    "remotePort",
    "specusConfigList"
  ],
  "properties": {
    "clientName": {
      "type": "string",
      "minLength": 1,
      "description": "目标客户端名。"
    },
    "remoteAddress": {
      "type": [
        "string",
        "null"
      ],
      "description": "服务端公网地址，可为空，主要用于展示。"
    },
    "remotePort": {
      "$ref": "#/$defs/Port",
      "description": "控制连接端口。"
    },
    "specusConfigList": {
      "type": "array",
      "description": "已启用 TCP 端口映射全集。空数组表示清空。缺省不合法。",
      "items": {
        "$ref": "#/$defs/SpecusConfig"
      }
    },
    "httpSpecusConfigList": {
      "type": "array",
      "description": "已启用 HTTP route 全集。字段缺省表示服务端尚未接管该客户端 HTTP route；空数组表示清空。",
      "items": {
        "$ref": "#/$defs/HttpSpecusConfig"
      }
    }
  },
  "$defs": {
    "Port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "SpecusConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port",
        "specusAddress",
        "specusPort"
      ],
      "properties": {
        "port": {
          "$ref": "#/$defs/Port",
          "description": "服务端公网监听端口。"
        },
        "specusAddress": {
          "type": "string",
          "minLength": 1,
          "description": "客户端侧目标地址。"
        },
        "specusPort": {
          "$ref": "#/$defs/Port",
          "description": "客户端侧目标端口。"
        }
      }
    },
    "HttpSpecusConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route",
        "targetBaseUrl"
      ],
      "properties": {
        "route": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._~-]+$",
          "description": "公网入口 /http/{clientName}/{route}/** 中的 route。"
        },
        "targetBaseUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://",
          "description": "客户端侧目标基础地址。"
        },
        "insecureSkipVerify": {
          "type": "boolean",
          "default": false,
          "description": "是否跳过该目标的 HTTPS/WSS 证书链与主机名校验；缺省为 false。"
        }
      }
    }
  }
}
