  "ipv6Prefixes": {
    "description": "IPv6 地址与前缀的写法，消费端规则的 match 与出口策略的目的规则共用。address 为 RFC 5952 规范形式，prefixLength 为前缀长度（单地址为 128）。reject 中的写法一律读不出：消费端规则报 EGRESS_RULE_MALFORMED，服务端保存策略以 400 拒绝。",
    "accept": [
      {
        "text": "2001:db8::/32",
        "address": "2001:db8::",
        "prefixLength": 32,
        "reason": "前缀"
      },
      {
        "text": "2001:DB8:0:0::/32",
        "address": "2001:db8::",
        "prefixLength": 32,
        "reason": "大小写与零组只是写法，按数值读"
      },
      {
        "text": "2001:0db8:0000:0000:0000:0000:0000:0001",
        "address": "2001:db8::1",
        "prefixLength": 128,
        "reason": "完整写法；每组前导零可写可不写"
      },
      {
        "text": "2001:db8::7/128",
        "address": "2001:db8::7",
        "prefixLength": 128,
        "reason": "带 /128 的单地址"
      },
