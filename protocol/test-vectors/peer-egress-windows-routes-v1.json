    "interfaceIndex": [
      {
        "name": "a-plain-name",
        "adapter": "specus0",
        "expect": "ConvertTo-Json -Compress -InputObject @(Get-NetAdapter -Name 'specus0' -ErrorAction SilentlyContinue|Select-Object InterfaceIndex)"
      },
      {
        "name": "a-name-with-spaces",
        "adapter": "Specus Tunnel",
        "reason": "Wintun 适配器名来自配置，空格是合法的",
        "expect": "ConvertTo-Json -Compress -InputObject @(Get-NetAdapter -Name 'Specus Tunnel' -ErrorAction SilentlyContinue|Select-Object InterfaceIndex)"
      },
      {
        "name": "a-name-with-a-quote",
        "adapter": "it's",
        "reason": "单引号必须变成两个。地址那边用白名单没有转义，因为白名单里没有引号；接口名不能白名单成数字，所以这里转义是真的防线",
        "expect": "ConvertTo-Json -Compress -InputObject @(Get-NetAdapter -Name 'it''s' -ErrorAction SilentlyContinue|Select-Object InterfaceIndex)"
      },
      {
        "name": "a-localised-name",
        "adapter": "以太网",
        "reason": "采样机上默认网卡就叫这个。名字进得去，但脚本只 Select 索引，所以出来的 JSON 是纯 ASCII",
        "expect": "ConvertTo-Json -Compress -InputObject @(Get-NetAdapter -Name '以太网' -ErrorAction SilentlyContinue|Select-Object InterfaceIndex)"
      }
    ],
    "showAllRoutes": "ConvertTo-Json -Compress -InputObject @(Get-NetRoute -AddressFamily IPv4 -ErrorAction SilentlyContinue|Select-Object InterfaceIndex,DestinationPrefix,NextHop,RouteMetric)"
  },
