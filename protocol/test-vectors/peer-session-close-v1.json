    {"name":"other-session","messages":[{"type":"close","sessionId":300,"sourceClientId":1,"targetClientId":7}],"closedPeerId":9},
    {"name":"duplicate-close","messages":[{"type":"close","sessionId":200},{"type":"close","sessionId":200,"sourceClientId":1,"targetClientId":7}],"closedPeerId":7},
