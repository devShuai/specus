    {"name":"zero-id","messages":[{"type":"close","sessionId":0,"sourceClientId":1,"targetClientId":7}],"closedPeerId":0},
    {"name":"negative-id","messages":[{"type":"close","sessionId":-1,"sourceClientId":1,"targetClientId":7}],"closedPeerId":0},
    {"name":"old-id","messages":[{"type":"close","sessionId":100,"sourceClientId":1,"targetClientId":7}],"closedPeerId":0},
    {"name":"unknown-id","messages":[{"type":"close","sessionId":999,"sourceClientId":1,"targetClientId":7}],"closedPeerId":0},
    {"name":"id-only","messages":[{"type":"close","sessionId":200}],"closedPeerId":7},
    {"name":"current-id","messages":[{"type":"close","sessionId":200,"sourceClientId":1,"targetClientId":7}],"closedPeerId":7},
    {"name":"reverse-endpoints","messages":[{"type":"close","sessionId":200,"sourceClientId":7,"targetClientId":1}],"closedPeerId":7},
