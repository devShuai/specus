        "name": "scoped-duplicates-are-not-candidates",
        "table": "duplicates",
        "tunnel": "utun3",
        "destination": "203.0.113.9",
        "note": "Three routes for 203.0.113.0/24: an unscoped one via en0 and two scoped with I, one of them to lo0. Only the unscoped one is a candidate.",
        "expect": {
          "interface": "en0"
        }
      },
      {
        "name": "nothing-left-when-the-physical-interface-is-named-as-the-tunnel",
        "table": "duplicates",
        "tunnel": "en0",
        "destination": "203.0.113.9",
        "note": "Every unscoped route to the destination is on en0, the scoped lo0 route does not count, and 127/8 does not cover it.",
        "expect": {
          "interface": null
        }
      },
