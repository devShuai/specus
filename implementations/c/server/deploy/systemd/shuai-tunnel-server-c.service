[Unit]
Description=shuai-tunnel C server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/shuai-tunnel/server-c.env
ExecStart=/usr/local/bin/shuai-tunnel-server-c
Restart=on-failure
RestartSec=3
LimitNOFILE=1048576
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
