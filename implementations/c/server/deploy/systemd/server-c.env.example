SPECUS_ENV=prod
SPECUS_NETTY_BIND_ADDRESS=0.0.0.0
SPECUS_NETTY_PORT=7010
SPECUS_ADMIN_PORT=8088
SPECUS_CLIENT_NAME=Demo client
SPECUS_CLIENT_SESSION_ID=1
SPECUS_CLIENT_ACCESS_TOKEN=change-me-runtime-token
SPECUS_PUBLIC_ADDRESS=127.0.0.1
SPECUS_PEER_MESH_ENABLED=false
SPECUS_PEER_MESH_PUBLIC_ADDRESS=
SPECUS_PEER_MESH_BIND_ADDRESS=0.0.0.0
SPECUS_PEER_MESH_STUN_TURN_PORT=3478
SPECUS_PEER_MESH_NAT_PROBE_ALTERNATE_PORT=3479
SPECUS_PEER_MESH_STUN_PRIMARY_BIND_ADDRESS=
SPECUS_PEER_MESH_STUN_ALTERNATE_BIND_ADDRESS=
SPECUS_PEER_MESH_STUN_ALTERNATE_PUBLIC_ADDRESS=
SPECUS_PEER_MESH_PUBLIC_STUN_SERVERS=
SPECUS_PEER_MESH_TURN_AUTH_REQUIRED=true
SPECUS_PEER_MESH_TURN_SHARED_SECRET=
SPECUS_PEER_MESH_TURN_CREDENTIAL_TTL_SECONDS=3600
SPECUS_PEER_MESH_RELAY_MIN_PORT=49152
SPECUS_PEER_MESH_RELAY_MAX_PORT=65535
SPECUS_PEER_MESH_GENERAL_RELAY_MAX_ALLOCATIONS=256
SPECUS_PEER_MESH_GENERAL_RELAY_MAX_ALLOCATIONS_PER_ADDRESS=4
SPECUS_PEER_MESH_GENERAL_RELAY_MAX_BYTES=536870912
SPECUS_PEER_MESH_CIDR=100.96.0.0/11
SPECUS_PEER_MESH_SESSION_TTL_SECONDS=120
SPECUS_PEER_MESH_CATALOG_TTL_SECONDS=90
SPECUS_PUBLIC_TRANSFER_MAX_DISCOVERY_PEERS_PER_ROOM=32
SPECUS_PUBLIC_TRANSFER_CLUSTER_ENABLED=false
# Required when cluster mode is true. Keep credentials out of the checked-in template.
# SPECUS_PUBLIC_TRANSFER_REDIS_URI=redis://user:password@redis.internal:6379/0
SPECUS_PUBLIC_TRANSFER_REDIS_KEY_PREFIX=specus:v2:public-transfer
SPECUS_PUBLIC_TRANSFER_PRESENCE_LEASE_SECONDS=30
SPECUS_PUBLIC_TRANSFER_PRESENCE_REFRESH_INTERVAL_MS=10000
SPECUS_PUBLIC_TRANSFER_REDIS_COMMAND_TIMEOUT_MS=2000
SPECUS_PUBLIC_TRANSFER_DISCOVERY_MESSAGE_RATE_LIMIT_PER_CONNECTION=360
SPECUS_PUBLIC_TRANSFER_DISCOVERY_MESSAGE_RATE_LIMIT_WINDOW_SECONDS=60
SPECUS_PUBLIC_TRANSFER_DISCOVERY_WRITE_TIMEOUT_SECONDS=5
SPECUS_PUBLIC_TRANSFER_PAIRING_CODE_TTL_SECONDS=300
SPECUS_PUBLIC_TRANSFER_PAIRING_CODE_REDEEM_RATE_LIMIT_PER_IP=10
SPECUS_PUBLIC_TRANSFER_PAIRING_CODE_REDEEM_RATE_LIMIT_WINDOW_SECONDS=300
# Optional attachments. Leave provider empty to fail closed with OBJECT_STORAGE_DISABLED.
SPECUS_OBJECT_STORAGE_PROVIDER=
SPECUS_OBJECT_STORAGE_ENDPOINT=
SPECUS_OBJECT_STORAGE_REGION=
SPECUS_OBJECT_STORAGE_BUCKET=
SPECUS_OBJECT_STORAGE_ACCESS_KEY_ID=
SPECUS_OBJECT_STORAGE_ACCESS_KEY_SECRET=
SPECUS_OBJECT_STORAGE_PREFIX=specus/attachments
SPECUS_OBJECT_STORAGE_MAX_ATTACHMENT_BYTES=536870912
SPECUS_OBJECT_STORAGE_RETENTION_HOURS=72
SPECUS_OBJECT_STORAGE_EXPIRATION_SCAN_INTERVAL_MS=3600000
# Optional route media capture; use a dedicated RustFS/S3-compatible bucket.
SPECUS_MEDIA_CAPTURE_ENABLED=false
SPECUS_MEDIA_CAPTURE_ENDPOINT=
SPECUS_MEDIA_CAPTURE_REGION=
SPECUS_MEDIA_CAPTURE_BUCKET=
SPECUS_MEDIA_CAPTURE_ACCESS_KEY_ID=
SPECUS_MEDIA_CAPTURE_ACCESS_KEY_SECRET=
SPECUS_MEDIA_CAPTURE_PREFIX=specus/media
SPECUS_MEDIA_CAPTURE_RETENTION_SECONDS=604800
SPECUS_MEDIA_CAPTURE_CLEANUP_INTERVAL_MS=60000
# Optional traffic-detail Elasticsearch backend.
SPECUS_ELASTICSEARCH_URIS=
SPECUS_ELASTICSEARCH_USERNAME=
SPECUS_ELASTICSEARCH_PASSWORD=
SPECUS_ELASTICSEARCH_API_KEY=
# Hosted package storage and official GitHub fallback.
SPECUS_CLIENT_PACKAGE_DATA_DIRECTORY=/var/lib/specus/client-packages
SPECUS_CLIENT_PACKAGE_GITHUB_RELEASE_FALLBACK_ENABLED=true
SPECUS_CLIENT_PACKAGE_GITHUB_RELEASE_CACHE_SECONDS=1800
SPECUS_CLIENT_PACKAGE_PUBLIC_RATE_LIMIT_PER_IP=120
SPECUS_CLIENT_PACKAGE_PUBLIC_RATE_LIMIT_WINDOW_SECONDS=60
# Optional account registration; configure SMTP/Turnstile secrets outside source control.
SPECUS_AUTH_REGISTRATION_ENABLED=false
SPECUS_AUTH_EMAIL_VERIFICATION_ENABLED=false
SPECUS_AUTH_EMAIL_CLEANUP_INTERVAL_MS=3600000
# Set only to the CIDRs of reverse proxies that overwrite X-Real-IP and append X-Forwarded-For.
SPECUS_TRUSTED_PROXIES=
SPECUS_STATIC_ROOT=/opt/specus-c/admin-web
SPECUS_TCP_MAPPINGS=18080=127.0.0.1:8080
SPECUS_CONTROL_READ_IDLE_SECONDS=60
SPECUS_CONTROL_WRITE_TIMEOUT_SECONDS=30
SPECUS_MAX_GLOBAL_EXTERNAL_CONNECTIONS=4096
SPECUS_MAX_CLIENT_EXTERNAL_CONNECTIONS=1024
SPECUS_MAX_PORT_EXTERNAL_CONNECTIONS=512
# Production must use mode=file, or bind a private address behind a trusted L4 TLS terminator
# and explicitly set SPECUS_TLS_TERMINATED_UPSTREAM=true.
SPECUS_TLS_MODE=file
SPECUS_TLS_KEYSTORE=/etc/specus/server.p12
SPECUS_TLS_KEYSTORE_PASSWORD=change-me
SPECUS_TLS_KEY_PASSWORD=change-me
SPECUS_TLS_REQUIRE_ENCRYPTION=true
SPECUS_TLS_TERMINATED_UPSTREAM=false
