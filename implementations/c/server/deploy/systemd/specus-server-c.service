[Unit]
Description=specus C server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/specus/server-c.env
ExecStart=/usr/local/bin/specus-server-c
Restart=on-failure
RestartSec=3
LimitNOFILE=1048576
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
