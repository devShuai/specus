{
  "$schema": "https://specus.devshuai.com/schemas/client-startup-config.schema.json",
  // client.jsonc is JSONC: comments and trailing commas are supported.
  "serverBaseUrl": "http://127.0.0.1:8088",
  "apiKey": "YOUR_CLIENT_API_KEY",
  "secret": "YOUR_CLIENT_SECRET",
  // Omit enabled to follow nettyTls advertised by the login response.
  // Any TLS option below also enables TLS; enabled=false rejects such options.
  "controlTls": {
    // "enabled": true,
    // "caCertificatePath": "./ca.pem",
    // "serverName": "control.example.com",
    "insecureSkipVerify": false
  },
  "peerMeshDevice": "noop",
  "peerMeshTunName": "specus0",
  "peerMeshMtu": 1280,
  // Send chosen destinations through another device. Needs a virtual NIC (peerMeshDevice other
  // than "noop") and administrator/root. See docs/peer-mesh/peer-egress-usage.md.
  // "peerEgressRules": [
  //   {"match": "203.0.113.0/24", "action": "egress", "egressClientId": 2},
  //   {"match": "198.51.100.0/24", "action": "block"}
  // ],
  // Phase one only checks and opens the download guide; it never replaces the running jar.
  "updateCheckEnabled": true,
  // Shared-schema compatibility only: Java phase one never self-replaces, even when true.
  "autoUpdate": false,
  // Checked once at startup, then every 1..168 hours (values outside the range are clamped).
  "updateCheckIntervalHours": 24,
  "openUpdatePage": true
}
