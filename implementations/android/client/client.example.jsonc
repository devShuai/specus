{
  "$schema": "https://specus.devshuai.com/schemas/client-startup-config.schema.json",
  // Android client config. Comments and trailing commas are supported.
  "serverBaseUrl": "https://specus.devshuai.com",
  "apiKey": "YOUR_CLIENT_API_KEY",
  "secret": "YOUR_CLIENT_SECRET",
  "controlTls": {
    // Omit enabled to follow login response nettyTls. Any non-empty TLS option also enables TLS.
    "enabled": null,
    "caCertificatePath": "",
    "serverName": "",
    // Development only. Cannot be combined with caCertificatePath.
    "insecureSkipVerify": false
  },
  "peerMeshDevice": "noop",
  "peerMeshTunName": "specus0",
  "peerMeshMtu": 1280
}
