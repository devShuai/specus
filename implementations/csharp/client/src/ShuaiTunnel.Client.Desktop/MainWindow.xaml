<Window x:Class="ShuaiTunnel.Client.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="shuai-tunnel 桌面客户端"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#EEF3F9">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="White"
                BorderBrush="#DDE4EE"
                BorderThickness="0,0,1,0"
                Padding="22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0"
                              Grid.RowSpan="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="shuai-tunnel"
                                   FontSize="26"
                                   FontWeight="Bold" />
                        <TextBlock Text="桌面客户端"
                                   Margin="0,4,0,22"
                                   Foreground="{StaticResource MutedBrush}" />

                        <TextBlock Text="服务端地址" FontWeight="SemiBold" />
                        <TextBox x:Name="ServerBaseUrlBox"
                                 Margin="0,6,0,14"
                                 ToolTip="例如 https://tunnel.devshuai.com 或 http://127.0.0.1:8088" />

                        <TextBlock Text="API Key" FontWeight="SemiBold" />
                        <TextBox x:Name="ApiKeyBox"
                                 Margin="0,6,0,14" />

                        <TextBlock Text="Secret" FontWeight="SemiBold" />
                        <PasswordBox x:Name="SecretBox"
                                     Margin="0,6,0,14" />

                        <TextBlock Text="虚拟网卡模式" FontWeight="SemiBold" />
                        <ComboBox x:Name="PeerMeshDeviceBox"
                                  IsEditable="True"
                                  Margin="0,6,0,14">
                            <ComboBoxItem Content="auto" />
                            <ComboBoxItem Content="windows-wintun" />
                            <ComboBoxItem Content="noop" />
                        </ComboBox>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="94" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="网卡名称" FontWeight="SemiBold" />
                                <TextBox x:Name="TunNameBox" Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="MTU" FontWeight="SemiBold" />
                                <TextBox x:Name="MtuBox" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>

                        <Button x:Name="ConnectButton"
                                Content="连接"
                                Height="42"
                                Background="#1378FF"
                                Foreground="White"
                                FontWeight="Bold"
                                Click="ConnectButton_Click" />
                        <Button x:Name="SaveButton"
                                Content="保存配置"
                                Height="38"
                                Margin="0,10,0,18"
                                Background="#E9EEF6"
                                Foreground="#172033"
                                Click="SaveButton_Click" />
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2"
                        Background="#F7F9FC"
                        BorderBrush="#DDE4EE"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14">
                    <StackPanel>
                        <TextBlock Text="当前状态"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}" />
                        <TextBlock x:Name="StatusPhaseText"
                                   Text="未连接"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,8,0,4" />
                        <TextBlock x:Name="StatusDetailText"
                                   Text="填写连接信息后启动客户端"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="26,22,26,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="160" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="运行视图"
                               FontSize="24"
                               FontWeight="Bold" />
                    <TextBlock x:Name="RuntimeSummaryText"
                               Text="连接后显示客户端、控制端和 Peer Mesh 信息"
                               Margin="0,5,0,0"
                               Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
                <UniformGrid Grid.Column="1"
                             Rows="1"
                             Columns="3"
                             Margin="18,0,0,0">
                    <Border Background="White"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14"
                            Margin="0,0,10,0"
                            Width="150">
                        <StackPanel>
                            <TextBlock Text="TCP 路由" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="TcpCountText" Text="0" FontSize="22" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                    <Border Background="White"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14"
                            Margin="0,0,10,0"
                            Width="150">
                        <StackPanel>
                            <TextBlock Text="HTTP 路由" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="HttpCountText" Text="0" FontSize="22" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                    <Border Background="White"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14"
                            Width="150">
                        <StackPanel>
                            <TextBlock Text="Peer 对端" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="PeerCountText" Text="0" FontSize="22" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Grid>

            <TabControl Grid.Row="1"
                        Margin="0,20,0,18"
                        Style="{StaticResource ModernTabControlStyle}"
                        ItemContainerStyle="{StaticResource ModernTabItemStyle}">
                <TabItem Header="对端路由">
                    <Border Background="White"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="190" />
                            </Grid.RowDefinitions>
                            <Border Background="#F7FAFE"
                                    BorderBrush="#E8EDF5"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="14"
                                    Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="10"
                                            Height="10"
                                            CornerRadius="5"
                                            Background="{StaticResource AccentBrush}"
                                            VerticalAlignment="Center"
                                            Margin="0,0,10,0" />
                                    <TextBlock x:Name="PeerMeshSummaryText"
                                               Grid.Column="1"
                                               Text="Peer Mesh 未启动"
                                               FontWeight="SemiBold"
                                               Foreground="#24324A" />
                                </Grid>
                            </Border>
                            <DataGrid x:Name="PeerGrid"
                                      Grid.Row="1"
                                      AlternationCount="2"
                                      ItemsSource="{Binding PeerRoutes}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="客户端" Binding="{Binding ClientName}" Width="2*" />
                                    <DataGridTextColumn Header="虚拟 IP" Binding="{Binding VirtualIp}" Width="*" />
                                    <DataGridCheckBoxColumn Header="在线" Binding="{Binding Online}" Width="80" />
                                    <DataGridTextColumn Header="候选地址" Binding="{Binding CandidateCount}" Width="90" />
                                    <DataGridTextColumn Header="Client ID" Binding="{Binding ClientId}" Width="150" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Grid.Row="2"
                                       Text="活跃会话"
                                       FontWeight="SemiBold"
                                       Foreground="#24324A"
                                       Margin="0,14,0,8" />
                            <DataGrid x:Name="PeerSessionGrid"
                                      Grid.Row="3"
                                      AlternationCount="2"
                                      ItemsSource="{Binding PeerSessions}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="对端" Binding="{Binding PeerName}" Width="2*" />
                                    <DataGridTextColumn Header="虚拟 IP" Binding="{Binding PeerVirtualIp}" Width="*" />
                                    <DataGridTextColumn Header="路径" Binding="{Binding PathType}" Width="90" />
                                    <DataGridTextColumn Header="Endpoint" Binding="{Binding RemoteEndpoint}" Width="2*" />
                                    <DataGridTextColumn Header="RTT(ms)" Binding="{Binding RttMillis}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </TabItem>
                <TabItem Header="本机 TCP 路由">
                    <Border Background="White"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="16">
                        <DataGrid x:Name="TcpRouteGrid"
                                  AlternationCount="2"
                                  ItemsSource="{Binding TcpRoutes}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="公网端口" Binding="{Binding PublicPort}" Width="120" />
                                <DataGridTextColumn Header="本机目标" Binding="{Binding Target}" Width="2*" />
                                <DataGridTextColumn Header="目标地址" Binding="{Binding TargetAddress}" Width="2*" />
                                <DataGridTextColumn Header="目标端口" Binding="{Binding TargetPort}" Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </TabItem>
                <TabItem Header="本机 HTTP 路由">
                    <Border Background="White"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="16">
                        <DataGrid x:Name="HttpRouteGrid"
                                  AlternationCount="2"
                                  ItemsSource="{Binding HttpRoutes}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Route" Binding="{Binding Route}" Width="*" />
                                <DataGridTextColumn Header="Target Base URL" Binding="{Binding TargetBaseUrl}" Width="4*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </TabItem>
            </TabControl>

            <Border Grid.Row="2"
                    Background="#111827"
                    CornerRadius="10"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="运行日志"
                               Foreground="#D8DEE9"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <ListBox x:Name="LogList"
                             Grid.Row="1"
                             ItemsSource="{Binding Logs}"
                             Background="#111827"
                             BorderThickness="0"
                             Foreground="#D8DEE9"
                             ItemContainerStyle="{StaticResource LogListBoxItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontFamily="Consolas"
                                           FontSize="12"
                                           Foreground="#D8DEE9"
                                           Text="{Binding Text}"
                                           TextWrapping="NoWrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
