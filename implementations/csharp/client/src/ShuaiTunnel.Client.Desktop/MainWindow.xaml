<Window x:Class="ShuaiTunnel.Client.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="shuai-tunnel 桌面客户端"
        Width="1280"
        Height="800"
        MinWidth="1120"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/favicon.ico"
        Background="{DynamicResource AppBackgroundBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid x:Name="RootLayoutGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,1,0"
                Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0"
                              Grid.RowSpan="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,8,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="46"
                                    Height="46"
                                    CornerRadius="10"
                                    Background="#14161F"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <Border Margin="7.5"
                                            CornerRadius="8"
                                            BorderBrush="#F2F3F7"
                                            BorderThickness="3" />
                                    <Border Margin="13"
                                            CornerRadius="6"
                                            BorderBrush="#F2F3F7"
                                            BorderThickness="3"
                                            Opacity="0.62" />
                                    <Border Margin="18"
                                            CornerRadius="4"
                                            BorderBrush="#F2F3F7"
                                            BorderThickness="3"
                                            Opacity="0.34" />
                                    <Border Width="5"
                                            Height="5"
                                            CornerRadius="2"
                                            Background="#9B82FF"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="shuai-tunnel"
                                           FontSize="24"
                                           FontWeight="Bold" />
                                <TextBlock Text="桌面客户端"
                                           Margin="0,2,0,0"
                                           Foreground="{DynamicResource MutedBrush}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="服务端地址" Style="{StaticResource SectionLabelTextStyle}" />
                        <TextBox x:Name="ServerBaseUrlBox"
                                 Margin="0,6,0,14"
                                 ToolTip="例如 https://tunnel.devshuai.com 或 http://127.0.0.1:8088" />

                        <TextBlock Text="API Key" Style="{StaticResource SectionLabelTextStyle}" />
                        <TextBox x:Name="ApiKeyBox"
                                 Margin="0,6,0,14" />

                        <TextBlock Text="Secret" Style="{StaticResource SectionLabelTextStyle}" />
                        <PasswordBox x:Name="SecretBox"
                                     Margin="0,6,0,14" />

                        <TextBlock Text="虚拟网卡模式" Style="{StaticResource SectionLabelTextStyle}" />
                        <ComboBox x:Name="PeerMeshDeviceBox"
                                  IsEditable="True"
                                  Margin="0,6,0,14">
                            <ComboBoxItem Content="auto" />
                            <ComboBoxItem Content="windows-wintun" />
                            <ComboBoxItem Content="noop" />
                        </ComboBox>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="94" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="网卡名称" Style="{StaticResource SectionLabelTextStyle}" />
                                <TextBox x:Name="TunNameBox" Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="MTU" Style="{StaticResource SectionLabelTextStyle}" />
                                <TextBox x:Name="MtuBox" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>

                        <Button x:Name="ConnectButton"
                                Content="连接"
                                Height="42"
                                Style="{StaticResource PrimaryButtonStyle}"
                                FontWeight="Bold"
                                Click="ConnectButton_Click" />
                        <Button x:Name="SaveButton"
                                Content="保存配置"
                                Height="38"
                                Margin="0,10,0,18"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="SaveButton_Click" />
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2"
                        Style="{StaticResource SurfacePanelStyle}"
                        Padding="15">
                    <StackPanel>
                        <TextBlock Text="当前状态"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedBrush}" />
                        <TextBlock x:Name="StatusPhaseText"
                                   Text="未连接"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,8,0,4" />
                        <TextBlock x:Name="StatusDetailText"
                                   Text="填写连接信息后启动客户端"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid x:Name="MainContentGrid" Grid.Column="1" Margin="28,24,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="160" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="运行视图"
                               FontSize="24"
                               FontWeight="Bold" />
                    <TextBlock x:Name="RuntimeSummaryText"
                               Text="连接后显示客户端、控制端和 Peer Mesh 信息"
                               Margin="0,5,0,0"
                               Foreground="{DynamicResource MutedBrush}" />
                </StackPanel>
                <Border x:Name="PeerMeshStatusStrip"
                        Grid.Column="1"
                        Style="{StaticResource InfoStripStyle}"
                        MaxWidth="460"
                        Padding="12,9"
                        Margin="20,0,12,0"
                        VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="PeerMeshStatusDot"
                                Width="10"
                                Height="10"
                                CornerRadius="5"
                                Background="{DynamicResource TextMutedBrush}"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0" />
                        <TextBlock x:Name="PeerMeshSummaryText"
                                   Grid.Column="1"
                                   Text="Peer Mesh 未启动"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource PrimaryHoverBrush}" />
                    </Grid>
                </Border>
                <Button x:Name="ThemeModeButton"
                        Grid.Column="2"
                        Width="38"
                        Height="38"
                        MinHeight="38"
                        Padding="9"
                        BorderThickness="0"
                        VerticalAlignment="Center"
                        Click="ThemeModeButton_Click">
                    <Viewbox Width="18"
                             Height="18"
                             Stretch="Uniform">
                        <Path x:Name="ThemeModeIcon"
                              Data="M4,5 H20 V15 H4 Z M8,19 H16 M12,15 V19"
                              Stroke="{DynamicResource TextSecondaryBrush}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                    </Viewbox>
                </Button>
                <UniformGrid Grid.Row="1"
                             Grid.ColumnSpan="3"
                             Rows="1"
                             Columns="3"
                             Margin="0,16,0,0">
                    <Border Style="{StaticResource MetricCardStyle}"
                             Margin="0,0,10,0"
                             MinWidth="0">
                        <StackPanel>
                            <TextBlock Text="TCP 路由" Foreground="{DynamicResource MutedBrush}" />
                            <TextBlock x:Name="TcpCountText" Text="0" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryHoverBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCardStyle}"
                             Margin="0,0,10,0"
                             MinWidth="0">
                        <StackPanel>
                            <TextBlock Text="HTTP 路由" Foreground="{DynamicResource MutedBrush}" />
                            <TextBlock x:Name="HttpCountText" Text="0" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryHoverBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCardStyle}"
                            MinWidth="0">
                        <StackPanel>
                            <TextBlock Text="Peer 对端" Foreground="{DynamicResource MutedBrush}" />
                            <TextBlock x:Name="PeerCountText" Text="0" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryHoverBrush}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Grid>

            <TabControl Grid.Row="1"
                        Margin="0,18,0,18"
                        Style="{StaticResource ModernTabControlStyle}"
                        ItemContainerStyle="{StaticResource ModernTabItemStyle}">
                <TabItem Header="对端路由">
                    <Grid>
                            <Grid.RowDefinitions>
                                <!-- 两张表按比例分配并设最小高度：窗口再矮也不会把
                                     任何一张表挤没，表格外框始终完整可见，行数多时表内滚动 -->
                                <RowDefinition Height="3*" MinHeight="120" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2*" MinHeight="110" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Style="{StaticResource TableShellStyle}">
                                <DataGrid x:Name="PeerGrid"
                                          AlternationCount="2"
                                          ItemsSource="{Binding PeerRoutes}">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="客户端" SortMemberPath="ClientName" ClipboardContentBinding="{Binding ClientName}" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Style="{StaticResource GridCellSelectableTextBoxStyle}"
                                                             Text="{Binding ClientName}"
                                                             ToolTip="{Binding ClientName}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="虚拟 IP" SortMemberPath="VirtualIp" ClipboardContentBinding="{Binding VirtualIp}" Width="150">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Style="{StaticResource GridCellSelectableTextBoxStyle}"
                                                             Text="{Binding VirtualIp}"
                                                             ToolTip="{Binding VirtualIp}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridCheckBoxColumn Header="在线" Binding="{Binding Online}" Width="80" />
                                        <DataGridTemplateColumn Header="候选地址" SortMemberPath="CandidateCount" ClipboardContentBinding="{Binding CandidateCount}" Width="90">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Style="{StaticResource GridCellSelectableTextBoxStyle}"
                                                             Text="{Binding CandidateCount}"
                                                             ToolTip="{Binding CandidateCount}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Client ID" SortMemberPath="ClientId" ClipboardContentBinding="{Binding ClientId}" Width="170">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Style="{StaticResource GridCellSelectableTextBoxStyle}"
                                                             Text="{Binding ClientId}"
                                                             ToolTip="{Binding ClientId}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                            <TextBlock Grid.Row="1"
                                       Text="活跃会话"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,14,0,8" />
                            <Border Grid.Row="2"
                                    Style="{StaticResource TableShellStyle}">
                                <DataGrid x:Name="PeerSessionGrid"
                                          AlternationCount="2"
                                          ItemsSource="{Binding PeerSessions}">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="对端" SortMemberPath="PeerName" ClipboardContentBinding="{Binding PeerName}" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Style="{StaticResource GridCellSelectableTextBoxStyle}"
                                                             Text="{Binding PeerName}"
                                                             ToolTip="{Binding PeerName}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="虚拟 IP" SortMemberPath="PeerVirtualIp" ClipboardContentBinding="{Binding PeerVirtualIp}" Width="150">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Style="{StaticResource GridCellSelectableTextBoxStyle}"
                                                             Text="{Binding PeerVirtualIp}"
                                                             ToolTip="{Binding PeerVirtualIp}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="路径" SortMemberPath="PathType" ClipboardContentBinding="{Binding PathType}" Width="90">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Style="{StaticResource GridCellSelectableTextBoxStyle}"
                                                             Text="{Binding PathType}"
                                                             ToolTip="{Binding PathType}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Endpoint" SortMemberPath="RemoteEndpoint" ClipboardContentBinding="{Binding RemoteEndpoint}" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Style="{StaticResource GridCellSelectableTextBoxStyle}"
                                                             Text="{Binding RemoteEndpoint}"
                                                             ToolTip="{Binding RemoteEndpoint}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="RTT(ms)" SortMemberPath="RttMillis" ClipboardContentBinding="{Binding RttMillis}" Width="90">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Style="{StaticResource GridCellSelectableTextBoxStyle}"
                                                             Text="{Binding RttMillis}"
                                                             ToolTip="{Binding RttMillis}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                    </Grid>
                </TabItem>
                <TabItem Header="客户端消息">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource SurfacePanelStyle}"
                                Padding="14"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="92" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="MessageTargetBox"
                                          IsEditable="True"
                                          ItemsSource="{Binding PeerRoutes}"
                                          DisplayMemberPath="ClientName"
                                          SelectedValuePath="ClientName"
                                          Margin="0,0,10,0" />
                                <TextBox x:Name="MessageBodyBox"
                                         Grid.Column="1"
                                         MinHeight="38"
                                         MaxHeight="96"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Margin="0,0,10,0" />
                                <Button x:Name="SendMessageButton"
                                        Grid.Column="2"
                                        Content="发送"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        IsEnabled="False"
                                        Click="SendMessageButton_Click" />
                            </Grid>
                        </Border>
                        <Border Grid.Row="1"
                                Style="{StaticResource TableShellStyle}">
                            <DataGrid x:Name="ClientMessageGrid"
                                      AlternationCount="2"
                                      ItemsSource="{Binding ClientMessages}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="时间" SortMemberPath="CreatedAtText" ClipboardContentBinding="{Binding CreatedAtText}" Width="92">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Style="{StaticResource GridCellSelectableTextBoxStyle}"
                                                         Text="{Binding CreatedAtText}"
                                                         ToolTip="{Binding CreatedAtText}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="方向" SortMemberPath="DirectionText" ClipboardContentBinding="{Binding DirectionText}" Width="82">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Style="{StaticResource GridCellSelectableTextBoxStyle}"
                                                         Text="{Binding DirectionText}"
                                                         ToolTip="{Binding DirectionText}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="对端" SortMemberPath="Peer" ClipboardContentBinding="{Binding Peer}" Width="2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Style="{StaticResource GridCellSelectableTextBoxStyle}"
                                                         Text="{Binding Peer}"
                                                         ToolTip="{Binding Peer}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="通道" SortMemberPath="TransportText" ClipboardContentBinding="{Binding TransportText}" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Style="{StaticResource GridCellSelectableTextBoxStyle}"
                                                         Text="{Binding TransportText}"
                                                         ToolTip="{Binding TransportText}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="状态" SortMemberPath="StatusText" ClipboardContentBinding="{Binding StatusText}" Width="92">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Style="{StaticResource GridCellSelectableTextBoxStyle}"
                                                         Text="{Binding StatusText}"
                                                         ToolTip="{Binding StatusText}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="消息" SortMemberPath="Message" ClipboardContentBinding="{Binding Message}" Width="4*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Style="{StaticResource GridCellSelectableTextBoxStyle}"
                                                         Text="{Binding Message}"
                                                         ToolTip="{Binding Message}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>
                <TabItem Header="本机 TCP 路由">
                    <Border Style="{StaticResource TableShellStyle}">
                        <DataGrid x:Name="TcpRouteGrid"
                                      AlternationCount="2"
                                      ItemsSource="{Binding TcpRoutes}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="公网端口" SortMemberPath="PublicPort" ClipboardContentBinding="{Binding PublicPort}" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Style="{StaticResource GridCellSelectableTextBoxStyle}"
                                                         Text="{Binding PublicPort}"
                                                         ToolTip="{Binding PublicPort}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="本机目标" SortMemberPath="Target" ClipboardContentBinding="{Binding Target}" Width="2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Style="{StaticResource GridCellSelectableTextBoxStyle}"
                                                         Text="{Binding Target}"
                                                         ToolTip="{Binding Target}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="目标地址" SortMemberPath="TargetAddress" ClipboardContentBinding="{Binding TargetAddress}" Width="2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Style="{StaticResource GridCellSelectableTextBoxStyle}"
                                                         Text="{Binding TargetAddress}"
                                                         ToolTip="{Binding TargetAddress}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="目标端口" SortMemberPath="TargetPort" ClipboardContentBinding="{Binding TargetPort}" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Style="{StaticResource GridCellSelectableTextBoxStyle}"
                                                         Text="{Binding TargetPort}"
                                                         ToolTip="{Binding TargetPort}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </TabItem>
                <TabItem Header="本机 HTTP 路由">
                    <Border Style="{StaticResource TableShellStyle}">
                        <DataGrid x:Name="HttpRouteGrid"
                                      AlternationCount="2"
                                      ItemsSource="{Binding HttpRoutes}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Route" SortMemberPath="Route" ClipboardContentBinding="{Binding Route}" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Style="{StaticResource GridCellSelectableTextBoxStyle}"
                                                         Text="{Binding Route}"
                                                         ToolTip="{Binding Route}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Target Base URL" SortMemberPath="TargetBaseUrl" ClipboardContentBinding="{Binding TargetBaseUrl}" Width="4*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Style="{StaticResource GridCellSelectableTextBoxStyle}"
                                                         Text="{Binding TargetBaseUrl}"
                                                         ToolTip="{Binding TargetBaseUrl}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </TabItem>
            </TabControl>

            <Border x:Name="LogPanelBorder"
                    Grid.Row="2"
                    Background="{DynamicResource LogBackgroundBrush}"
                    BorderBrush="{DynamicResource PanelStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="运行日志"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Button x:Name="LogExpandButton"
                                Grid.Column="1"
                                Content="放大"
                                MinHeight="0"
                                Height="26"
                                Padding="12,2"
                                FontSize="12"
                                ToolTip="放大到整个窗口（Esc 还原）"
                                Click="LogExpandButton_Click" />
                    </Grid>
                    <ScrollViewer x:Name="LogScrollViewer"
                                  Grid.Row="1"
                                  Style="{StaticResource LogScrollViewerStyle}"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="LogTextBox"
                                 MinWidth="{Binding ViewportWidth, ElementName=LogScrollViewer}"
                                 Style="{StaticResource LogTextBoxStyle}" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
