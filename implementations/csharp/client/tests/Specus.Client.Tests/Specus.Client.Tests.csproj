<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Specus.Client\Specus.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The desktop app targets net10.0-windows for WPF, but the transfer state machine itself is
         plain BCL code. Compile it here so its receive path is covered on any host. -->
    <Compile Include="..\..\src\Specus.Client.Desktop\FileTransferManager.cs"
             Link="Desktop\FileTransferManager.cs" />
    <Compile Include="..\..\src\Specus.Client.Desktop\DesktopClientSettings.cs"
             Link="Desktop\DesktopClientSettings.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
