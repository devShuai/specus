<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>ShuaiTunnel.Server</RootNamespace>
    <TunnelServerWebSkip>false</TunnelServerWebSkip>
    <DefaultItemExcludes>$(DefaultItemExcludes);wwwroot\**\*</DefaultItemExcludes>
  </PropertyGroup>

  <Target Name="BuildAndSyncAdminWeb"
          BeforeTargets="ResolveStaticWebAssetsInputs;AssignTargetPaths"
          Condition="'$(TunnelServerWebSkip)' != 'true' and '$(DesignTimeBuild)' != 'true'">
    <Exec WorkingDirectory="$(MSBuildThisFileDirectory)..\..\..\..\..\apps\admin-web"
          Command="npm run deploy:csharp" />
    <ItemGroup>
      <Content Remove="wwwroot\**\*" />
      <Content Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\..\..\protocol\src\ShuaiTunnel.Protocol\ShuaiTunnel.Protocol.csproj" />
    <ProjectReference Include="..\ShuaiTunnel.Server.Data\ShuaiTunnel.Server.Data.csproj" />
    <!-- Provider migration assemblies must be referenced so MigrationsAssembly(...) can load
         them at runtime. Only the one matching Tunnel:Database:Provider is actually used. -->
    <ProjectReference Include="..\ShuaiTunnel.Server.Data.Postgres\ShuaiTunnel.Server.Data.Postgres.csproj" />
    <ProjectReference Include="..\ShuaiTunnel.Server.Data.MySql\ShuaiTunnel.Server.Data.MySql.csproj" />
  </ItemGroup>

</Project>
