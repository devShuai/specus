<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Specus.Server.Data</RootNamespace>
    <!--
      EF Core 10.0.9 transitively pulls SQLitePCLRaw.lib.e_sqlite3 2.1.11, which carries
      GHSA-2m69-gcr7-jv3q. No patched 2.1.x has shipped to nuget yet. Until the upstream
      bundles ship a fixed version, suppress NU1903 here so warnings-as-errors doesn't
      block the build. Revisit when SQLitePCLRaw 2.1.12+ is available.
    -->
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.9" />
  </ItemGroup>

</Project>
