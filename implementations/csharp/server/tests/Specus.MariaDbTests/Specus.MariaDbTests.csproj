<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <!-- Deliberately separate from the offline solution: a real owned MariaDB is
       mandatory, and absent/wrong infrastructure fails rather than skips. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <ProjectReference Include="../../src/Specus.Server/Specus.Server.csproj" />
    <Compile Include="../Specus.IntegrationTests/TestServerFixture.cs" Link="TestServerFixture.cs" />
    <Compile Include="../Specus.IntegrationTests/ControlDisconnectProviderProof.cs" Link="ControlDisconnectProviderProof.cs" />
    <Compile Include="../Specus.IntegrationTests/OwnerTransferWriterProof.cs" Link="OwnerTransferWriterProof.cs" />
    <Compile Include="../Specus.IntegrationTests/ClientConfigurationProviderProof.cs" Link="ClientConfigurationProviderProof.cs" />
    <Compile Include="../Specus.IntegrationTests/ManagementUserActorProviderProof.cs" Link="ManagementUserActorProviderProof.cs" />
    <Compile Include="../Specus.IntegrationTests/ClientStartupProviderProof.cs" Link="ClientStartupProviderProof.cs" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
