<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.9" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Specus.StunServer\Specus.StunServer.csproj" />
    <ProjectReference Include="..\..\src\Specus.Server\Specus.Server.csproj" />
    <ProjectReference Include="..\..\src\Specus.Server.Data\Specus.Server.Data.csproj" />
    <!-- Referenced so MultiProviderModelTests can construct the Npgsql/MySQL contexts and load
         their migration snapshots for offline DDL + model-drift checks. -->
    <ProjectReference Include="..\..\src\Specus.Server.Data.Postgres\Specus.Server.Data.Postgres.csproj" />
    <ProjectReference Include="..\..\src\Specus.Server.Data.MySql\Specus.Server.Data.MySql.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
