{
  "$schema": "https://specus.devshuai.com/schemas/client-startup-config.schema.json",
  // client.jsonc is JSONC: comments and trailing commas are supported.
  "serverBaseUrl": "http://127.0.0.1:8088",
  "apiKey": "replace-with-client-api-key",
  "secret": "replace-with-client-secret",
  // Check this server's package catalog on startup and periodically while running.
  "updateCheckEnabled": true,
  // Service deployments may opt in to unattended replacement. Interactive use asks first.
  "autoUpdate": false,
  // Periodic checks are clamped to 1..168 hours; omitted/invalid values default to 24.
  "updateCheckIntervalHours": 24,
  "controlTls": {
    // null follows serverBaseUrl: HTTPS enables TLS, HTTP disables it.
    "enabled": null,
    "caCertificatePath": "",
    "serverName": "",
    "insecureSkipVerify": false,
  },
  "peerMeshDevice": "noop",
  "peerMeshTunName": "specus0",
  "peerMeshMtu": 1280,
}
