<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <artifactId>shuai-tunnel</artifactId>
        <groupId>com.theshuai</groupId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <artifactId>tunnel-client</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>tunnel-client</name>
    <description>tunnel-client</description>
    <properties>
        <java.version>21</java.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.theshuai</groupId>
            <artifactId>tunnel-common</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <jvmArguments>--enable-native-access=ALL-UNNAMED</jvmArguments>
                    <!--
                        repackage 默认会把 thin-jar 替换为 fat-jar，导致下游 test-scope 依赖
                        （如 tunnel-server 的 EndToEndTunnelIT）拿到 fat-jar，类路径污染、
                        编译期 import 也找不到。给 repackage 一个 classifier，让 fat-jar 以
                        tunnel-client-*-exec.jar 形式存在，原始 thin-jar 仍然以普通 jar 安装到本地仓库。
                    -->
                    <classifier>exec</classifier>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
