<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>
    <groupId>com.theshuai</groupId>
    <artifactId>specus</artifactId>
    <packaging>pom</packaging>
    <version>1.0-SNAPSHOT</version>
    <modules>
        <module>implementations/java/common</module>
        <module>implementations/java/client</module>
        <module>implementations/java/server</module>
        <module>implementations/java/stun-server</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <!--
            Single source for the Java client artifact and manifest version. Release builds still
            override it with -Drevision=<tag without v>; the default keeps ordinary local packages
            aligned with the current published client instead of reporting a stale 1.0.0-SNAPSHOT.
        -->
        <revision>1.2.3</revision>
        <!--
            Overrides of the Spring Boot managed versions, each raising a dependency past a high
            severity advisory that the managed version still carries. They live in the root pom
            because every module inherits the same Boot BOM, and a fix applied to one module would
            leave the others on the vulnerable version.

            netty            4.2.15 -> 4.2.17: GHSA-2qj4-mmr9-4v2f plus fourteen more across the codecs
            httpcore5        5.4.2  -> 5.4.3:  GHSA-hf6x-8p5f-cgmf, GHSA-v3jc-474w-2wm6
            postgresql       42.7.11 -> 42.7.12: GHSA-j92g-9f8w-j867
            jackson 2.x     2.21.4 -> 2.21.5: GHSA-5gvw-p9qm-jgwh, GHSA-5jmj-h7xm-6q6v,
                             GHSA-mhm7-754m-9p8w
            jackson 3.x     3.1.4  -> 3.1.5:  same advisories under tools.jackson.core,
                             which Boot manages through a separate property
            log4j2           2.25.4 -> 2.25.5: GHSA-qv9r-c865-cp47
            httpclient5      5.6.1  -> 5.6.4:  GHSA-hjcp-jmpx-g3qm, a connection leak on a
                             Content-Encoding decode error that exhausts the pool

            Patch releases are chosen over the newer minor lines (2.22.2, 2.26.1) so the change
            carries the fix and nothing else.

            Drop an override once the Boot BOM catches up. The dependency audit workflow is what
            reports that it has, and what fails the build if one of these regresses.
        -->
        <netty.version>4.2.17.Final</netty.version>
        <httpcore5.version>5.4.3</httpcore5.version>
        <postgresql.version>42.7.12</postgresql.version>
        <jackson-2-bom.version>2.21.5</jackson-2-bom.version>
        <jackson-bom.version>3.1.5</jackson-bom.version>
        <log4j2.version>2.25.5</log4j2.version>
        <httpclient5.version>5.6.4</httpclient5.version>
        <!--
            Not a security fix. MySQL switched to a year-based scheme, so 26.7.0 follows 9.7.0
            rather than preceding it; the jump in the number is calendar, not eighteen majors of
            breaking change.
        -->
        <mysql.version>26.7.0</mysql.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
                netty-all pins its own codec versions, so the netty.version property alone does not
                reach them. Importing the BOM is what keeps every Netty artifact on one version.
            -->
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-bom</artifactId>
                <version>${netty.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.46</version>
        </dependency>

        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>33.6.0-jre</version>
        </dependency>

        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-all</artifactId>
        </dependency>

        <dependency>
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5</artifactId>
            <!-- 版本跟随上面的 httpclient5.version 覆盖；写死在这里会让属性覆盖失效。 -->
        </dependency>

        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2</artifactId>
            <version>2.0.62</version>
        </dependency>

        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.20.0</version>
        </dependency>

        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>2.22.0</version>
        </dependency>

    </dependencies>


    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.15.0</version>
                    <configuration>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>1.18.46</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <configuration>
                        <archive>
                            <manifestEntries>
                                <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                            </manifestEntries>
                        </archive>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <pluginRepositories>
        <pluginRepository>
            <id>nexus</id>
            <url>https://nexus.devshuai.com/repository/maven-public/</url>
        </pluginRepository>
        <pluginRepository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </pluginRepository>
    </pluginRepositories>

    <repositories>
        <repository>
            <id>nexus</id>
            <url>https://nexus.devshuai.com/repository/maven-public/</url>
            <snapshots>
                <updatePolicy>always</updatePolicy>
            </snapshots>
        </repository>
        <repository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <distributionManagement>
        <repository>
            <id>releases</id>
            <url>https://nexus.devshuai.com/repository/maven-releases/</url>
        </repository>
        <snapshotRepository>
            <id>snapshots</id>
            <url>https://nexus.devshuai.com/repository/maven-snapshots/</url>
        </snapshotRepository>
    </distributionManagement>

</project>
