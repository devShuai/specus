{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Tunnel": "Data Source=./shuai-tunnel.db"
  },
  "Tunnel": {
    "Netty": {
      "Port": 7010,
      "MaxFrameSize": 33554432,
      "WriteBufferLowWaterMark": 32768,
      "WriteBufferHighWaterMark": 65536,
      "MaxExternalConnections": 10000,
      "MaxExternalConnectionsPerClient": 10000,
      "MaxExternalConnectionsPerPort": 10000
    },
    "PublicAddress": null,
    "Login": {
      "ExecutorCoreSize": 8,
      "ExecutorMaxSize": 32,
      "ExecutorQueueCapacity": 20000
    },
    "Database": {
      "SeedDemoClient": true
    },
    "Traffic": {
      "FlushIntervalMs": 5000
    }
  }
}
